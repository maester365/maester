is unavailable (shallow clone) and no contributors snapshot exists at website/src/data/contributors.json.\"","+        \"Full git history is unavailable (shallow clone) and website/src/data/contributors.json does not exist. Run git fetch --unshallow.\"","       );","     }","-    log(\"Shallow git clone detected - using committed contributors snapshot.\");","+    log(\"Shallow git clone detected - using the existing website/src/data/contributors.json.\");","     return JSON.parse(readFileSync(snapshotPath, \"utf8\"));","   }"," "]}]}],"moreFiles":0,"changedFiles":["/Users/merill/github/maester/.claude/worktrees/website-astro/website/scripts/contributors.mjs"]}},"serverClassifierContext":{"request":"4e25af08-7b70-463b-b67c-8fc5541394b5","context":{"git_state":{"cwd":"/Users/merill/github/maester/.claude/worktrees/website-astro","root":"/Users/merill/github/maester/.claude/worktrees/website-astro","branch":"feat/website-astro","default_branch":null,"status":{"clean":false,"counts":{"staged":81,"modified":7,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"maester365/maester","visibility":"public"},"push_remote":"origin","remotes":[{"name":"blindzero","host":"github.com","remote":"blindzero/maester","visibility":"unknown"},{"name":"jeanphilippegeorge","host":"github.com","remote":"JeanPhilippeGeorge/maester","visibility":"unknown"},{"name":"mynster","host":"github.com","remote":"Mynster9361/maester","visibility":"unknown"},{"name":"origin","host":"github.com","remote":"maester365/maester","visibility":"public"},{"name":"pr-author","host":"github.com","remote":"soulemike/maester","visibility":"unknown"},{"name":"thetechgy","host":"github.com","remote":"thetechgy/maester","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"maester365/maester","visibility":"public"}]}},"live_cwd":"/Users/merill/github/maester/.claude/worktrees/website-astro","platform":"macos"}},"sandbox