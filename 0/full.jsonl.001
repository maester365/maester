{"parentUuid":"60fd1cc8-b61e-4140-b14b-a8f27f7e5427","isSidechain":false,"promptId":"58789495-d689-47a3-9518-1f06f8190e00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P1VS9oJEuEB7axiKXjuekg","type":"tool_result","content":"The file /Users/merill/github/maester/.claude/worktrees/website-astro/website/src/lib/summary.mjs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"55d71e13-23e0-42ad-b745-3322f68e1cc6","timestamp":"2026-11-02T13:51:33.564Z","toolUseResult":{"filePath":"/Users/merill/github/maester/.claude/worktrees/website-astro/website/src/lib/summary.mjs","oldString":"// Removes comments until none are left: one pass over \"<!<!---->--\" would leave a new \"<!--\" behind.\nfunction stripComments(text) {\n\tlet previous;\n\tdo {\n\t\tprevious = text;\n\t\ttext = text.replace(/\\{\\/\\*[\\s\\S]*?\\*\\/\\}|<!--[\\s\\S]*?-->/g, '');\n\t} while (text !== previous);\n\treturn text;\n}","newString":"// Removes comments until none are left (one pass over \"<!<!---->--\" would leave a new \"<!--\" behind), then any\n// opener or closer left without its pair.\nfunction stripComments(text) {\n\tlet previous;\n\tdo {\n\t\tprevious = text;\n\t\ttext = text.replace(/\\{\\/\\*[\\s\\S]*?\\*\\/\\}|<!--[\\s\\S]*?-->/g, '');\n\t} while (text !== previous);\n\treturn text.replace(/<!--|-->|\\{\\/\\*|\\*\\/\\}/g, '');\n}","originalFile":"// A plain-text summary of Markdown for a meta description: the first real paragraph, without Markdown syntax, cut\n// at a sentence or word boundary at most `max` characters long. Used for test pages (scripts/generate-test-docs.mjs)\n// and for any docs page without a description of its own (src/routeData.ts).\n\n// Removes comments until none are left: one pass over \"<!<!---->--\" would leave a new \"<!--\" behind.\nfunction stripComments(text) {\n\tlet previous;\n\tdo {\n\t\tprevious = text;\n\t\ttext = text.replace(/\\{\\/\\*[\\s\\S]*?\\*\\/\\}|<!--[\\s\\S]*?-->/g, '');\n\t} while (text !== previous);\n\treturn text;\n}\n\nexport function plain(markdown) {\n\treturn stripComments(String(markdown ?? '').replace(/^---[\\s\\S]*?^---/m, '').replace(/^(import|export)\\s.*$/gm, ''))\n\t\t.replace(/^(```|~~~)[\\s\\S]*?^\\1/gm, '')\n\t\t.replace(/<[^>]+>/g, ' ')\n\t\t.replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')\n\t\t.replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, '$1')\n\t\t.replace(/https?:\\/\\/\\S+/g, '')\n\t\t.replace(/`([^`]*)`/g, '$1')\n\t\t.replace(/(\\*\\*|__|\\*|_)(\\S[^*_]*?)\\1/g, '$2')\n\t\t.replace(/\\\\([!-/:-@[-`{-~])/g, '$1');\n}\n\nexport function summarize(markdown, max = 155) {\n\tconst blocks = plain(markdown)\n\t\t.split(/\\n\\s*\\n/)\n\t\t.map((b) => b.trim())\n\t\t// Skip headings, admonitions, tables, lists of links and labels such as \"Learn more:\".\n\t\t.filter((b) => b && !/^(#{1,6}\\s|:::|\\||[-*+]\\s|\\d+\\.\\s|>\\s)/.test(b) && b.replace(/\\s+/g, ' ').length >= 40);\n\tconst first = blocks[0]?.replace(/\\s+/g, ' ').replace(/\\s*(Learn more|See also|Remediation action):?.*$/i, '').trim();\n\tif (!first) return '';\n\tif (first.length <= max) return first;\n\tconst cut = first.slice(0, max);\n\tconst sentence = cut.match(/^(.{60,}[.!?])\\s/);\n\tif (sentence) return sentence[1];\n\treturn `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:\\s]+$/, '')}…`;\n}\n","structuredPatch":[{"oldStart":2,"oldLines":14,"newStart":2,"newLines":15,"lines":[" // at a sentence or word boundary at most `max` characters long. Used for test pages (scripts/generate-test-docs.mjs)"," // and for any docs page without a description of its own (src/routeData.ts)."," ","-// Removes comments until none are left: one pass over \"<!<!---->--\" would leave a new \"<!--\" behind.","+// Removes comments until none are left (one pass over \"<!<!---->--\" would leave a new \"<!--\" behind), then any","+// opener or closer left without its pair."," function stripComments(text) {","   let previous;","   do {","     previous = text;","     text = text.replace(/\\{\\/\\*[\\s\\S]*?\\*\\/\\}|<!--[\\s\\S]*?-->/g, '');","   } while (text !== previous);","-  return text;","+  return text.replace(/<!--|-->|\\{\\/\\*|\\*\\/\\}/g, '');"," }"," "," export function plain(markdown) {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"60fd1cc8-b61e-4140-b14b-a8f27f7e5427","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/merill/github/maester/.claude/worktrees/website-astro/website","sessionId":"2d9f0177-c129-494c-a54f-610e3d37d77a","version":"2.1.309","gitBranch":"feat/website-astro","slug":"breezy-giggling-flame"}
