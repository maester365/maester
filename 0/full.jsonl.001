{"parentUuid":"24d54615-6ec1-492a-916a-a14cf6d9fe81","isSidechain":false,"promptId":"58789495-d689-47a3-9518-1f06f8190e00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JtZUWioHwjK6RqMuKqqmbK","type":"tool_result","content":"1\t// A plain-text summary of Markdown for a meta description: the first real paragraph, without Markdown syntax, cut\n2\t// at a sentence or word boundary at most `max` characters long. Used for test pages (scripts/generate-test-docs.mjs)\n3\t// and for any docs page without a description of its own (src/routeData.ts).\n4\t\n5\texport function plain(markdown) {\n6\t\treturn String(markdown ?? '')\n7\t\t\t.replace(/^---[\\s\\S]*?^---/m, '')\n8\t\t\t.replace(/^(import|export)\\s.*$/gm, '')\n9\t\t\t.replace(/\\{\\/\\*[\\s\\S]*?\\*\\/\\}|<!--[\\s\\S]*?-->/g, '')\n10\t\t\t.replace(/^(```|~~~)[\\s\\S]*?^\\1/gm, '')\n11\t\t\t.replace(/<[^>]+>/g, ' ')\n12\t\t\t.replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')\n13\t\t\t.replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, '$1')\n14\t\t\t.replace(/https?:\\/\\/\\S+/g, '')\n15\t\t\t.replace(/`([^`]*)`/g, '$1')\n16\t\t\t.replace(/(\\*\\*|__|\\*|_)(\\S[^*_]*?)\\1/g, '$2')\n17\t\t\t.replace(/\\\\([!-/:-@[-`{-~])/g, '$1');\n18\t}\n19\t\n20\texport function summarize(markdown, max = 155) {\n21\t\tconst blocks = plain(markdown)\n22\t\t\t.split(/\\n\\s*\\n/)\n23\t\t\t.map((b) => b.trim())\n24\t\t\t// Skip headings, admonitions, tables, lists of links and labels such as \"Learn more:\".\n25\t\t\t.filter((b) => b && !/^(#{1,6}\\s|:::|\\||[-*+]\\s|\\d+\\.\\s|>\\s)/.test(b) && b.replace(/\\s+/g, ' ').length >= 40);\n26\t\tconst first = blocks[0]?.replace(/\\s+/g, ' ').replace(/\\s*(Learn more|See also|Remediation action):?.*$/i, '').trim();\n27\t\tif (!first) return '';\n28\t\tif (first.length <= max) return first;\n29\t\tconst cut = first.slice(0, max);\n30\t\tconst sentence = cut.match(/^(.{60,}[.!?])\\s/);\n31\t\tif (sentence) return sentence[1];\n32\t\treturn `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:\\s]+$/, '')}…`;\n33\t}\n34\t"}]},"uuid":"6aa3e47c-5274-4bb6-bc73-5e314f17b8c0","timestamp":"2026-11-02T13:50:50.669Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/merill/github/maester/.claude/worktrees/website-astro/website/src/lib/summary.mjs","content":"// A plain-text summary of Markdown for a meta description: the first real paragraph, without Markdown syntax, cut\n// at a sentence or word boundary at most `max` characters long. Used for test pages (scripts/generate-test-docs.mjs)\n// and for any docs page without a description of its own (src/routeData.ts).\n\nexport function plain(markdown) {\n\treturn String(markdown ?? '')\n\t\t.replace(/^---[\\s\\S]*?^---/m, '')\n\t\t.replace(/^(import|export)\\s.*$/gm, '')\n\t\t.replace(/\\{\\/\\*[\\s\\S]*?\\*\\/\\}|<!--[\\s\\S]*?-->/g, '')\n\t\t.replace(/^(```|~~~)[\\s\\S]*?^\\1/gm, '')\n\t\t.replace(/<[^>]+>/g, ' ')\n\t\t.replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')\n\t\t.replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, '$1')\n\t\t.replace(/https?:\\/\\/\\S+/g, '')\n\t\t.replace(/`([^`]*)`/g, '$1')\n\t\t.replace(/(\\*\\*|__|\\*|_)(\\S[^*_]*?)\\1/g, '$2')\n\t\t.replace(/\\\\([!-/:-@[-`{-~])/g, '$1');\n}\n\nexport function summarize(markdown, max = 155) {\n\tconst blocks = plain(markdown)\n\t\t.split(/\\n\\s*\\n/)\n\t\t.map((b) => b.trim())\n\t\t// Skip headings, admonitions, tables, lists of links and labels such as \"Learn more:\".\n\t\t.filter((b) => b && !/^(#{1,6}\\s|:::|\\||[-*+]\\s|\\d+\\.\\s|>\\s)/.test(b) && b.replace(/\\s+/g, ' ').length >= 40);\n\tconst first = blocks[0]?.replace(/\\s+/g, ' ').replace(/\\s*(Learn more|See also|Remediation action):?.*$/i, '').trim();\n\tif (!first) return '';\n\tif (first.length <= max) return first;\n\tconst cut = first.slice(0, max);\n\tconst sentence = cut.match(/^(.{60,}[.!?])\\s/);\n\tif (sentence) return sentence[1];\n\treturn `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:\\s]+$/, '')}…`;\n}\n","numLines":34,"startLine":1,"totalLines":34}},"sourceToolAssistantUU