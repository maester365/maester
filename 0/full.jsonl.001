he Sponsors section of the repository README: the featured sponsors' logos and the wall.","+// It changes only when featured.yml does, and the build-website workflow fails a pull request that leaves it out","+// of date.","+//","+// Locally: GH_TOKEN=REDACTED auth token) node scripts/sponsors.mjs [--readme]"," ","-import { existsSync, readFileSync, writeFileSync } from \"node:fs\";","+import { existsSync, mkdirSync, readFileSync, writeFileSync } from \"node:fs\";"," import { dirname, join } from \"node:path\";"," import { fileURLToPath } from \"node:url\";"," import { load as loadYamlDocument } from \"js-yaml\";"]},{"oldStart":27,"oldLines":6,"newStart":33,"newLines":8,"lines":[" const featuredPath = join(websiteRoot, \"sponsors\", \"featured.yml\");"," const snapshotPath = join(websiteRoot, \"src\", \"data\", \"sponsors.json\");"," const readmePath = join(websiteRoot, \"..\", \"README.md\");","+const wallDir = join(websiteRoot, \"public\", \"readme\");","+const publishedUrl = \"https://maester.dev/data/sponsors.json\";"," const repository = \"maester365/maester\";"," "," const botPattern = /\\[bot\\]|copilot|github[- ]actions?|actions-user|dependabot|web-flow|snyk/i;"]},{"oldStart":243,"oldLines":16,"newStart":251,"newLines":18,"lines":["   return people;"," }"," ","-// The Sponsors section of the repository README, between its sponsors:start and sponsors:end markers: the same","-// sponsors as the thank-you on the page. Images have absolute URLs, as the module ships the README too.","+// The Sponsors section of the repository README, between its sponsors:start and sponsors:end markers: the","+// featured sponsors' logos, then the wall of everyone else who sponsors a maintainer. Images have absolute URLs,","+// as the module ships the README too. The wall is an image built on each deploy, so the README stays the same","+// when someone starts or stops sponsoring."," const imageBase = `https://raw.githubusercontent.com/${repository}/main/website/public`;"," const html = (text) =>","   String(text).replace(/[&<>\"]/g, (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" })[c]);"," ","-function readmeSection({ featured, backers }) {","+function readmeSection(featured) {","   const lines = [","     \"<!-- sponsors:start -->\",","-    \"<!-- Written by website/scripts/sponsors.mjs. To change the featured sponsors, edit website/sponsors/featured.yml. -->\",","+    \"<!-- Written by website/scripts/sponsors.mjs --readme. To change the featured sponsors, edit website/sponsors/featured.yml. -->\",","     \"\",","     \"## Sponsors\",","     \"\","]},{"oldStart":269,"oldLines":50,"newStart":279,"newLines":104,"lines":["     );","     lines.push(\"<p>\", `  ${logos.join(\"&nbsp;&nbsp;&nbsp;&nbsp;\\n  \")}`, \"</p>\", \"\");","   }","-  if (backers.length > 0) {","-    lines.push(\"<table>\");","-    for (let i = 0; i < backers.length; i += 6) {","-      lines.push(\"  <tr>\");","-      for (const backer of backers.slice(i, i + 6)) {","-        lines.push(","-          `    <td align=\"center\" width=\"110\"><a href=\"https://github.com/${html(backer.github)}\">` +","-            `<img src=\"${html(backer.avatar)}\" width=\"64\" height=\"64\" alt=\"\"><br><sub><b>${html(backer.name)}</b></sub></a></td>`","-        );","-      }","-      lines.push(\"  </tr>\");","-    }","-    lines.push(\"</table>\", \"\");","-  }","   lines.push(","+    `<a href=\"https://maester.dev/sponsor\"><picture>` +","+      `<source media=\"(prefers-color-scheme: dark)\" srcset=\"https://maester.dev/readme/sponsors-dark.svg\">` +","+      `<img src=\"https://maester.dev/readme/sponsors.svg\" alt=\"The people and organisations who sponsor the maintainers of Maester\">` +","+      `</picture></a>`,","+    \"\",","     \"Using Maester at work? Ask your company to sponsor one of the [people who build it](https://maester.dev/sponsor).\",","     \"<!-- sponsors:end -->\"","   );","   return lines.join(\"\\n\");"," }"," ","-function writeReadme(snapshot) {","+// The wall of sponsors in the README: each sponsor's avatar and name, six to a row. GitHub shows a README's images","+// through its image proxy, which doesn't load the images an SVG links to, so the avatars are embedded.","+async function embed(url) {","+  try {","+    const response = await fetch(url);","+    if (!response.ok) return url;","+    const type = response.headers.get(\"content-type\") ?? \"image/png\";","+    return `data:${type};base64,${Buffer.from(await response.arrayBuffer()).toString(\"base64\")}`;","+  } catch {","+    return url;","+  }","+}","+","+async function writeWall(backers) {","+  const columns = 6;","+  const cell = { width: 110, height: 100 };","+  const avatars = await Promise.all(backers.map((backer) => embed(backer.avatar)));","+  for (const [file, text, ring] of [","+    [\"sponsors.svg\", \"#1f2328\", \"#d1d9e0\"],","+    [\"sponsors-dark.svg\", \"#f0f6fc\", \"#3d444d\"],","+  ]) {","+    const rows = Math.max(1, Math.ceil(backers.length / columns));","+    const width = columns * cell.width;","+    const height = rows * cell.height;","+    const people = backers.map((backer, i) => {","+      const x = (i % columns) * cell.width + cell.width / 2;","+      const y = Math.floor(i / columns) * cell.height + 8;","+      const name = backer.name.length > 16 ? `${backer.name.slice(0, 15)}…` : backer.name;","+      return [","+        `<clipPath id=\"c${i}\"><circle cx=\"${x}\" cy=\"${y + 32}\" r=\"32\"/></clipPath>`,","+        `<image href=\"${html(avatars[i])}\" x=\"${x - 32}\" y=\"${y}\" width=\"64\" height=\"64\" clip-path=\"url(#c${i})\"/>`,","+        `<circle cx=\"${x}\" cy=\"${y + 32}\" r=\"32\" fill=\"none\" stroke=\"${ring}\"/>`,","+        `<text x=\"${x}\" y=\"${y + 84}\" text-anchor=\"middle\">${html(name)}</text>`,","+      ].join(\"\");","+    });","+    const empty = `<text x=\"${width / 2}\" y=\"${height / 2}\" text-anchor=\"middle\">Sponsor the people who build Maester at maester.dev/sponsor</text>`;","+    const svg =","+      `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${width}\" height=\"${height}\" viewBox=\"0 0 ${width} ${height}\" role=\"img\">` +","+      `<title>The sponsors of Maester's maintainers</title>` +","+      `<style>text{font:600 12px -apple-system,BlinkMacSystemFont,\"Segoe UI\",Helvetica,Arial,sans-serif;fill:${text}}</style>` +","+      `${backers.length > 0 ? people.join(\"\") : empty}</svg>\\n`;","+    writeFileSync(join(wallDir, file), svg);","+  }","+}","+","+function writeReadme(featured) {","   const readme = readFileSync(readmePath, \"utf8\");","   const markers = /<!-- sponsors:start -->[\\s\\S]*?<!-- sponsors:end -->/;","   if (!markers.test(readme)) {","     console.warn(\"sponsors: README.md has no sponsors:start and sponsors:end markers, leaving it as it is.\");","     return;","   }","-  writeFileSync(readmePath, readme.replace(markers, () => readmeSection(snapshot)));","+  writeFileSync(readmePath, readme.replace(markers, () => readmeSection(featured)));"," }"," "," const featured = featuredSponsors();"," const featuredLogins = new Set(featured.map((sponsor) => sponsor.github.toLowerCase()).filter(Boolean));"," ","+const emptyPeople = { maintainers: [], testAuthors: [], contributors: [], backers: [] };","+","+// The list published by the last deploy of maester.dev.","+async function publishedPeople(reason) {","+  try {","+    const response = await fetch(publishedUrl);","+    if (!response.ok) throw new Error(`${response.status}`);","+    console.log(`sponsors: ${reason}, using the list published at ${publishedUrl}.`);","+    return await response.json();","+  } catch (error) {","+    console.warn(`sponsors: ${reason}, and the list at ${publishedUrl} could not be read (${error.message}): no people are listed.`);","+    return emptyPeople;","+  }","+}","+"," let people;","-if (token) {","-  people = await lookUpPeople();","+if (!token) {","+  people = await publishedPeople(\"no GH_TOKEN or GITHUB_TOKEN\");"," } else {","-  console.log(\"sponsors: no GH_TOKEN or GITHUB_TOKEN, keeping the people of the committed snapshot.\");","-  people = JSON.parse(readFileSync(snapshotPath, \"utf8\"));","+  try {","+    people = await lookUpPeople();","+  } catch (error) {","+    people = await publishedPeople(`the lookup failed (${error.message})`);","+  }"," }"," "," // A featured sponsor who also sponsors a maintainer on GitHub is thanked once, with their logo.","-const { backers = [], ...groups } = people;","+const { backers = [], ...groups } = { ...emptyPeople, ...people };"," const snapshot = {","   ...groups,","   featured,"]},{"oldStart":320,"oldLines":5,"newStart":384,"newLines":7,"lines":[" };"," "," writeFileSync(snapshotPath, `${JSON.stringify(snapshot, null, 2)}\\n`);","-writeReadme(snapshot);","+mkdirSync(wallDir, { recursive: true });","+await writeWall(snapshot.backers);","+if (process.argv.includes(\"--readme\")) writeReadme(featured);"," console.log(`sponsors: ${snapshot.featured.length} featured sponsors, ${snapshot.backers.length} other sponsors thanked.`);"]}]}],"moreFiles":0,"changedFiles":["/Users/merill/github/maester/.claude/worktrees/website-astro/website/scripts/sponsors.mjs"]}},"serverClassifierContext":{"request":"8fd1ba90-7663-411a-9ed7-1b857b1bb893","context":{"git_state":{"cwd":"/Users/merill/github/maester/.claude/worktrees/website-astro/website","root":"/Users/merill/github/maester/.claude/worktrees/website-astro","branch":"feat/website-astro","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"maester365/maester","visibility":"public"},"push_remote":"origin","remotes":[{"name":"blindzero","host":"github.com","remote":"blindzero/maester","visibility":"unknown"},{"name":"jeanphilippegeorge","host":"github.com","remote":"JeanPhilippeGeorge/maester","visibility":"unknown"},{"name":"mynster","host":"github.com","