{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maester.dev/schemas/maester-pack-registry-1.0.json",
  "title": "Maester Pack registry entry (pack-registry/publishers/<publisher>.json)",
  "description": "A publisher in the Maester Pack registry and the packs whose codes it owns. See https://maester.dev/docs/packs/registry. build/packs/Test-MtPackRegistry.ps1 checks that every GUID, pack ID, code and publisher is unique.",
  "type": "object",
  "additionalProperties": false,
  "required": ["Guid", "Publisher", "Name", "Owners", "Packs"],
  "properties": {
    "$schema": { "type": "string" },
    "Guid": { "description": "The publisher's GUID.", "$ref": "#/$defs/guid" },
    "Publisher": {
      "description": "The GitHub user or organisation in lower case, the first part of the publisher's pack IDs. The file is named after it.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$"
    },
    "Name": { "description": "The publisher's display name.", "type": "string", "minLength": 1 },
    "Owners": {
      "description": "The GitHub accounts that may change this entry.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Login", "Id"],
        "properties": {
          "Login": { "type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
          "Id": { "description": "The account's numeric GitHub ID, which stays the same when it is renamed.", "type": "integer", "minimum": 1 }
        }
      }
    },
    "Packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Guid", "Id", "Code", "Repository"],
        "properties": {
          "Guid": { "description": "The Guid in the pack's maester-pack.json.", "$ref": "#/$defs/guid" },
          "Id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?\\.[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
          "Code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}(\\.[A-Z][A-Z0-9]{1,9}){0,2}$" },
          "Repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+/?$" }
        }
      }
    }
  },
  "$defs": {
    "guid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
  }
}
