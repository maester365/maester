---
// "Copy page" for AI tools: the page as Markdown, or a question about it in ChatGPT or Claude.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const mdPath = `${path}.md`;
const pageUrl = new URL(path, 'https://maester.dev').href;
const prompt = encodeURIComponent(`Read ${pageUrl} and help me with Maester.`);
---

<mt-copy-page class="mt-copy" data-md={mdPath}>
	<button type="button" class="mt-copy__main">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
		<span class="mt-copy__label">Copy page</span>
	</button>
	<details>
		<summary aria-label="More ways to use this page with AI"
			><svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg></summary
		>
		<div class="mt-copy__menu">
			<a href={mdPath}>View as Markdown</a>
			<a href={`https://chatgpt.com/?hints=search&q=${prompt}`} target="_blank" rel="noopener">Open in ChatGPT</a>
			<a href={`https://claude.ai/new?q=${prompt}`} target="_blank" rel="noopener">Open in Claude</a>
			<a href="/llms.txt">llms.txt for the whole site</a>
		</div>
	</details>
</mt-copy-page>

<script>
	class CopyPage extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector<HTMLButtonElement>('.mt-copy__main');
			const label = this.querySelector('.mt-copy__label');
			button?.addEventListener('click', async () => {
				try {
					const response = await fetch(this.dataset.md ?? '');
					await navigator.clipboard.writeText(await response.text());
					if (label) label.textContent = 'Copied';
				} catch {
					if (label) label.textContent = 'Could not copy';
				}
				setTimeout(() => label && (label.textContent = 'Copy page'), 2000);
			});
		}
	}
	customElements.define('mt-copy-page', CopyPage);
</script>

<style>
	.mt-copy {
		position: relative;
		display: inline-flex;
		margin-top: 1.1rem;
		flex: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 9px;
		font-size: 0.8125rem;
	}
	.mt-copy__main,
	summary {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: none;
		border: 0;
		color: var(--sl-color-white);
		font: inherit;
		font-weight: 600;
		padding: 0.35rem 0.65rem;
		cursor: pointer;
	}
	summary {
		list-style: none;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		height: 100%;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.mt-copy__menu {
		position: absolute;
		right: 0;
		top: calc(100% + 6px);
		z-index: 20;
		min-width: 15rem;
		display: flex;
		flex-direction: column;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 12px;
		padding: 0.35rem;
		box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.45);
	}
	.mt-copy__menu a {
		padding: 0.5rem 0.7rem;
		border-radius: 8px;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.mt-copy__menu a:hover {
		background: var(--sl-color-gray-6);
	}
	@media (max-width: 50rem) {
		.mt-copy {
			display: none;
		}
	}
</style>
