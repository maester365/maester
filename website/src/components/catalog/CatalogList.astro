---
// The checks of a view of the test catalog: all of them, a product's, a pack's or a suite's. Grouped by product,
// feature, area, severity, suite or pillar, filtered by the nav (state.ts), with the Invoke-Maester command that runs
// the same selection. Every check is in the HTML, so the list works without JavaScript and search engines see it.
import { checks, checkHref, packOf, packName, pillarName, plural, previewLabel, productIcon, productInitials, featureIcon, severityMix, suiteInfo, suiteMembers, channelOf, searchText, type Check } from './data';

interface Props {
	scope?: 'all' | 'product' | 'pack' | 'suite';
	value?: string;
}
const { scope = 'all', value = '' } = Astro.props;

const list: Check[] =
	scope === 'product' ? checks.filter((t) => t.product === value) : scope === 'pack' ? checks.filter((t) => t.pack === value) : scope === 'suite' ? checks.filter((t) => !t.pack && suiteMembers(value).includes(t.suite)) : checks;
const pack = scope === 'pack' ? packOf(value) : undefined;

// The default grouping of each view, and the groupings it offers.
const groupings: [string, string][] =
	scope === 'all'
		? [['product', 'Product'], ['area', 'Area'], ['severity', 'Severity'], ['suite', 'Suite'], ['none', 'None']]
		: scope === 'pack'
			? [['pillar', 'Pillar'], ['category', 'Category'], ['product', 'Product'], ['severity', 'Severity'], ['none', 'None']]
			: scope === 'product'
				? [['feature', 'Feature'], ['area', 'Area'], ['severity', 'Severity'], ['suite', 'Suite'], ['none', 'None']]
				: [['product', 'Product'], ['feature', 'Feature'], ['area', 'Area'], ['severity', 'Severity'], ['none', 'None']];
const defaultGroup = groupings[0][0];

// Tiles above the list: a product's features, a pack's pillars.
const tiles =
	scope === 'product'
		? [...new Set(list.map((t) => t.feature))]
				.filter(Boolean)
				.map((f) => ({ filter: 'feature', key: `${value}/${f}`, name: list.find((t) => t.feature === f)!.featureName, icon: featureIcon(value, f), rows: list.filter((t) => t.feature === f) }))
		: scope === 'pack'
			? [...new Set(list.flatMap((t) => t.pillar ?? []))].map((p) => ({ filter: 'pillar', key: p, name: pillarName(p), icon: undefined, pillar: p, rows: list.filter((t) => (t.pillar ?? []).includes(p)) }))
			: [];
tiles.sort((a, b) => b.rows.length - a.rows.length);
const mix = severityMix(list);
const total = list.length;
const width = (n: number, of: number) => `width: ${((n / of) * 100).toFixed(2)}%`;

// The columns of the list. ID and Check are always shown; the reader adds the others with the Columns menu, and their
// browser remembers the choice. The grid widths are in the script, which lays out the columns that are shown.
const columns: { key: string; label: string; standard?: boolean }[] = [
	{ key: 'where', label: scope === 'product' ? 'Feature' : 'Product', standard: true },
	...(scope === 'product' ? [] : [{ key: 'feature', label: 'Feature' }]),
	{ key: 'area', label: 'Area' },
	{ key: 'severity', label: 'Severity', standard: true },
	{ key: 'impact', label: 'User impact' },
	{ key: 'cost', label: 'Effort' },
	{ key: 'mitre', label: 'ATT&CK' },
	{ key: 'control', label: 'Controls' },
	...(scope === 'pack' ? [] : [{ key: 'source', label: 'Source' }]),
];
const standardColumns = columns.filter((c) => c.standard).map((c) => c.key);
const dash = '—';
const sourceLabel = (t: Check) => (t.pack ? packName(t.pack) : suiteInfo[t.suite]?.name ?? t.suite);
const channel = channelOf;
const baseCommand = scope === 'product' ? `Invoke-Maester -Product ${value}` : scope === 'suite' ? `Invoke-Maester -Suite ${suiteMembers(value).join(',').toLowerCase()}` : scope === 'pack' ? `Invoke-Maester -Pack ${value} -SkipBuiltIn` : 'Invoke-Maester';
---

<mt-catalog-list class="mt-cl not-content" data-standard-columns={standardColumns.join(' ')} data-scope={scope} data-value={value} data-default-group={defaultGroup} data-base={baseCommand}>
	{
		pack && (
			<div class="mt-cl__pack">
				<p>
					{pack.publisher === 'maester365' ? 'Ships with Maester.' : `Published by ${pack.publisher}.`} The checks are Microsoft's, from the{' '}
					<a href={pack.source}>{pack.module}</a> module{pack.moduleVersion ? ` ${pack.moduleVersion}` : ''}: Maester runs it and shows each result in its report, beside Maester's own checks. If a check's result,
					text or fix looks wrong, <a href={`${pack.source}/issues`}>report it to Microsoft</a>.
				</p>
				<a href={pack.homepage || '/docs/packs'}>About the pack →</a>
			</div>
		)
	}

	<div class="mt-cl__stats">
		<div class="mt-cl__bar" role="img" aria-label={mix.map((m) => `${m.count} ${m.key}`).join(', ')}>
			{mix.map((m) => <i class={`mt-sev-bg--${m.key.toLowerCase()}`} style={width(m.count, total)} />)}
		</div>
		<div class="mt-cl__legend">
			<span>
				<b>{total.toLocaleString('en-US')}</b> checks
			</span>
			{
				mix.map((m) => (
					<span>
						<i class={`mt-sev-bg--${m.key.toLowerCase()}`} />
						{m.count} {m.key}
					</span>
				))
			}
		</div>
	</div>

	{
		tiles.length > 1 && (
			<section class="mt-cl__tiles" aria-label={scope === 'pack' ? 'Pillars' : 'Features'}>
				{tiles.map((tile) => {
					const tmix = severityMix(tile.rows);
					return (
						<button type="button" class="mt-cl__tile" data-tile-filter={tile.filter} data-tile-value={tile.key} data-tile-pillar={(tile as any).pillar ?? ''} aria-pressed="false">
							<span class="mt-cl__tname">
								{tile.icon && <img src={tile.icon} alt="" width="16" height="16" loading="lazy" />}
								<span>{tile.name}</span>
								<span class="mt-cl__tn">{tile.rows.length}</span>
							</span>
							<span class="mt-cl__bar mt-cl__bar--thin">
								{tmix.map((m) => (
									<i class={`mt-sev-bg--${m.key.toLowerCase()}`} style={width(m.count, tile.rows.length)} />
								))}
							</span>
						</button>
					);
				})}
			</section>
		)
	}

	<div class="mt-cl__cmd">
		<span class="mt-cl__cmdlabel">Run these</span>
		<code data-cmd>{baseCommand}</code>
		<button type="button" data-copy>Copy</button>
		<span class="mt-cl__cmdnote" data-cmd-note hidden></span>
	</div>

	<div class="mt-cl__toolbar">
		<div class="mt-cl__chips" data-chips></div>
		<span class="mt-cl__count" data-count>{plural(total, 'check')}</span>
		<div class="mt-cl__seg" role="group" aria-label="Group by">
			<span>Group by</span>
			{groupings.map(([key, label]) => <button type="button" data-group={key} aria-pressed={String(key === defaultGroup)}>{label}</button>)}
		</div>
		<details class="mt-cl__cols" data-cols-menu>
			<summary>Columns</summary>
			<div class="mt-cl__colsbox" role="group" aria-label="Columns">
				{
					columns.map((c) => (
						<label>
							<input type="checkbox" data-col-toggle={c.key} checked={c.standard} />
							{c.label}
						</label>
					))
				}
				<button type="button" data-cols-reset>Reset to default</button>
			</div>
		</details>
	</div>

	<div class="mt-cl__table" data-table data-show={standardColumns.join(' ')}>
		<div class="mt-cl__head" role="group" aria-label="Sort by">
			{
				[{ key: 'id', label: 'ID' }, { key: 'title', label: 'Check' }, ...columns].map(({ key, label }) => (
					<button type="button" class="mt-cl__sort" data-sort={key} data-col={key} aria-pressed="false" title={`Sort by ${label === 'ID' ? 'ID' : label.toLowerCase()}`}>
						{label}
						<span class="mt-cl__sorti" aria-hidden="true">↕</span>
					</button>
				))
			}
		</div>
		<div data-rows>
			{
				list.map((t) => (
					<a
						href={checkHref(t)}
						class="mt-cl__row"
						data-q={searchText(t)}
						data-severity={t.severity}
						data-area={t.area}
						data-cost={t.cost}
						data-impact={t.impact}
						data-source={t.pack || 'maester'}
						data-community={t.community ? '' : undefined}
						data-channel={channel(t)}
						data-product={t.product}
						data-feature={t.feature ? `${t.product}/${t.feature}` : ''}
						data-suite={t.pack ? '' : t.suite}
						data-mitre={t.mitre.join(' ')}
						data-pillar={(t.pillar ?? []).join(' ')}
						data-author={(t.authors ?? []).join(' ')}
						data-g-product={`${t.product}|${t.productName || 'No product'}|${productIcon(t.product) ?? ''}|${t.product ? productInitials(t.product) : ''}`}
						data-g-feature={`${t.product}/${t.feature}|${t.featureName || 'No feature'}|${featureIcon(t.product, t.feature) ?? ''}`}
						data-g-area={`${t.area}|${t.areaName || 'No area'}`}
						data-g-severity={t.severity}
						data-g-suite={`${t.pack || t.suite}|${sourceLabel(t)}`}
						data-g-pillar={(t.pillar ?? []).map((p) => `${p}|${pillarName(p)}`).join(';') || '|No pillar'}
						data-g-category={`${t.category ?? ''}|${t.category || 'No category'}`}
						data-test-id={t.id}
						data-s-title={t.title}
						data-s-where={scope === 'product' ? t.featureName : t.productName}
						data-s-feature={t.featureName}
						data-s-area={t.areaName}
						data-s-control={t.control.join(' ')}
						data-s-source={sourceLabel(t)}
					>
						<span class:list={['mt-cl__id', { 'mt-cl__id--pack': Boolean(t.pack) }]}>{t.id}</span>
						<span class="mt-cl__title">
							{t.title}
							{t.community ? (
								<span class="mt-cl__badge mt-cl__badge--community" title={`From ${packName(t.pack)}, a community pack on packs.maester.cloud`}>Community pack · {t.pack}</span>
							) : (
								t.pack && scope !== 'pack' && <span class="mt-cl__badge mt-cl__badge--pack">{t.pack}</span>
							)}
							{t.previewOnly && !t.pack && <span class="mt-cl__badge">New in {previewLabel}</span>}
							{t.previewCheck && <span class="mt-cl__badge mt-cl__badge--mono">-IncludePreview</span>}
						</span>
						<span class="mt-cl__where" data-col="where">
							{scope === 'product' ? (
								t.featureName
							) : (
								<>
									{productIcon(t.product) ? (
										<img src={productIcon(t.product)} alt="" width="16" height="16" loading="lazy" />
									) : (
										t.product && <span class="mt-cl__ptile">{productInitials(t.product)}</span>
									)}
									{t.productName}
								</>
							)}
						</span>
						{scope !== 'product' && (
							<span class="mt-cl__where" data-col="feature">
								{featureIcon(t.product, t.feature) && <img src={featureIcon(t.product, t.feature)} alt="" width="16" height="16" loading="lazy" />}
								{t.featureName || dash}
							</span>
						)}
						<span class="mt-cl__cell" data-col="area">{t.areaName || dash}</span>
						<span data-col="severity">
							<span class={`mt-cl__sev mt-sev--${t.severity.toLowerCase()}`}>{t.severity}</span>
						</span>
						<span class="mt-cl__cell" data-col="impact">{t.impact || dash}</span>
						<span class="mt-cl__cell" data-col="cost">{t.cost || dash}</span>
						<span class="mt-cl__cell mt-cl__codes" data-col="mitre" title={t.mitre.join(', ')}>
							{t.mitre.length ? `${t.mitre.slice(0, 2).join(', ')}${t.mitre.length > 2 ? ` +${t.mitre.length - 2}` : ''}` : dash}
						</span>
						<span class="mt-cl__cell mt-cl__codes" data-col="control" title={t.control.join(', ')}>
							{t.control.length ? `${t.control.slice(0, 2).join(', ')}${t.control.length > 2 ? ` +${t.control.length - 2}` : ''}` : dash}
						</span>
						{scope !== 'pack' && <span class="mt-cl__cell" data-col="source">{sourceLabel(t)}</span>}
					</a>
				))
			}
		</div>
		<p class="mt-cl__empty" data-empty hidden>No checks match. <button type="button" data-clear>Clear the filters</button></p>
	</div>
</mt-catalog-list>

<script>
	import { matches, onState, readState, update, writeState, FILTERS, VIEW, type State } from './state';

	// The rows shown of a group before "Show all", and of the whole list when it is not grouped.
	const GROUP_ROWS = 8;
	const FLAT_ROWS = 100;
	const SEVERITIES = ['Critical', 'High', 'Medium', 'Low', 'Info'];

	// The columns the list sorts by. Ascending is the order a reader looks for first: the most severe first, A to Z.
	// A second click reverses it, a third goes back to the catalog's own order. Rows without a value stay last.
	const rankOf = (order: string[], v: string) => (order.includes(v) ? order.indexOf(v) : order.length);
	const SORTS: Record<string, { value: (r: HTMLElement) => string; compare: (a: string, b: string) => number }> = {
		id: { value: (r) => r.dataset.testId ?? '', compare: (a, b) => a.localeCompare(b, undefined, { numeric: true }) },
		title: { value: (r) => r.dataset.sTitle ?? '', compare: (a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }) },
		where: { value: (r) => r.dataset.sWhere ?? '', compare: (a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }) },
		severity: { value: (r) => (SEVERITIES.includes(r.dataset.severity ?? '') ? r.dataset.severity! : ''), compare: (a, b) => rankOf(SEVERITIES, a) - rankOf(SEVERITIES, b) },
		feature: { value: (r) => r.dataset.sFeature ?? '', compare: (a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }) },
		area: { value: (r) => r.dataset.sArea ?? '', compare: (a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }) },
		impact: { value: (r) => r.dataset.impact ?? '', compare: (a, b) => rankOf(LEVELS, a) - rankOf(LEVELS, b) },
		cost: { value: (r) => r.dataset.cost ?? '', compare: (a, b) => rankOf(LEVELS, a) - rankOf(LEVELS, b) },
		mitre: { value: (r) => r.dataset.mitre ?? '', compare: (a, b) => a.localeCompare(b, undefined, { numeric: true }) },
		control: { value: (r) => r.dataset.sControl ?? '', compare: (a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }) },
		source: { value: (r) => r.dataset.sSource ?? '', compare: (a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }) },
	};
	const LEVELS = ['Low', 'Medium', 'High'];

	// The grid track of each column, in the order the columns are laid out.
	// The table scrolls sideways once the columns' smallest widths (in rem) no longer fit.
	const TRACKS: [string, string, number][] = [
		['id', 'minmax(8rem, 12rem)', 8],
		['title', 'minmax(12rem, 1fr)', 12],
		['where', 'minmax(7rem, 12rem)', 7],
		['feature', 'minmax(7rem, 12rem)', 7],
		['area', 'minmax(6rem, 10rem)', 6],
		['severity', '5.5rem', 5.5],
		['impact', '5.5rem', 5.5],
		['cost', '5rem', 5],
		['mitre', 'minmax(5rem, 8rem)', 5],
		['control', 'minmax(6rem, 10rem)', 6],
		['source', 'minmax(5rem, 9rem)', 5],
	];
	const COLUMNS_KEY = 'maester.catalog.columns';
	const nextSort = (sort: string, key: string) => (sort === key ? `-${key}` : sort === `-${key}` ? '' : key);

	class CatalogList extends HTMLElement {
		expanded = new Set<string>();

		connectedCallback() {
			const rowsBox = this.querySelector<HTMLElement>('[data-rows]')!;
			const rows = [...rowsBox.querySelectorAll<HTMLAnchorElement>('.mt-cl__row')];
			const segButtons = [...this.querySelectorAll<HTMLButtonElement>('[data-group]')];
			const tiles = [...this.querySelectorAll<HTMLButtonElement>('[data-tile-filter]')];
			const cmd = this.querySelector<HTMLElement>('[data-cmd]')!;
			const note = this.querySelector<HTMLElement>('[data-cmd-note]')!;
			const countEl = this.querySelector<HTMLElement>('[data-count]')!;
			const chips = this.querySelector<HTMLElement>('[data-chips]')!;
			const empty = this.querySelector<HTMLElement>('[data-empty]')!;
			const defaultGroup = this.dataset.defaultGroup!;
			const scope = this.dataset.scope!;
			const total = rows.length;

			for (const b of segButtons) b.addEventListener('click', () => update({ group: b.dataset.group === defaultGroup ? [] : [b.dataset.group!] }));
			const sortButtons = [...this.querySelectorAll<HTMLButtonElement>('[data-sort]')];
			for (const b of sortButtons) {
				b.addEventListener('click', () => {
					const next = nextSort(readState().sort[0] ?? '', b.dataset.sort!);
					update({ sort: next ? [next] : [] });
				});
			}
			for (const tile of tiles) {
				tile.addEventListener('click', () => {
					const state = readState();
					if (tile.dataset.tilePillar) {
						const value = tile.dataset.tilePillar;
						const on = state.pillar.includes(value);
						update({ pillar: on ? state.pillar.filter((p) => p !== value) : [...state.pillar, value] });
					} else {
						const value = tile.dataset.tileValue!;
						const on = state.feature.includes(value);
						update({ feature: on ? state.feature.filter((f) => f !== value) : [...state.feature, value] });
					}
				});
			}
			this.querySelector('[data-copy]')?.addEventListener('click', (e) => {
				navigator.clipboard.writeText(cmd.textContent ?? '');
				const button = e.currentTarget as HTMLButtonElement;
				button.textContent = 'Copied';
				setTimeout(() => (button.textContent = 'Copy'), 1500);
			});
			this.querySelector('[data-clear]')?.addEventListener('click', () => {
				const state = readState();
				for (const name of FILTERS) if (!VIEW.includes(name)) state[name] = [];
				writeState(state);
			});

			this.columns();

			onState((state) => this.render(state, { rowsBox, rows, segButtons, sortButtons, tiles, cmd, note, countEl, chips, empty, defaultGroup, scope, total }));
		}

		// The Columns menu: which optional columns the list shows, remembered by the reader's browser.
		columns() {
			const table = this.querySelector<HTMLElement>('[data-table]')!;
			const menu = this.querySelector<HTMLDetailsElement>('[data-cols-menu]')!;
			const boxes = [...this.querySelectorAll<HTMLInputElement>('[data-col-toggle]')];
			const offered = boxes.map((b) => b.dataset.colToggle!);
			const standard = (this.dataset.standardColumns ?? '').split(' ').filter(Boolean);
			const apply = (keys: string[]) => {
				const shown = ['id', 'title', ...keys];
				table.dataset.show = keys.join(' ');
				const tracks = TRACKS.filter(([k]) => shown.includes(k));
				table.style.setProperty('--mt-cl-cols', tracks.map(([, w]) => w).join(' '));
				// Each track's smallest width, the 1rem gaps between them and the row's 1rem padding on each side.
				table.style.setProperty('--mt-cl-min', `${tracks.reduce((n, [, , min]) => n + min, 0) + tracks.length + 1}rem`);
				for (const b of boxes) b.checked = keys.includes(b.dataset.colToggle!);
			};
			const save = (keys: string[]) => {
				try {
					localStorage.setItem(COLUMNS_KEY, JSON.stringify(keys));
				} catch {
					/* not remembered */
				}
			};
			let saved: string[] | null = null;
			try {
				const value = JSON.parse(localStorage.getItem(COLUMNS_KEY) ?? 'null');
				if (Array.isArray(value)) saved = value.filter((k) => typeof k === 'string');
			} catch {
				/* the standard columns */
			}
			// A column saved on another view that this one does not offer (Feature on a product's page) is skipped here.
			apply(saved ? saved.filter((k) => offered.includes(k)) : standard);
			for (const b of boxes) {
				b.addEventListener('change', () => {
					const keys = boxes.filter((x) => x.checked).map((x) => x.dataset.colToggle!);
					const other = (saved ?? standard).filter((k) => !offered.includes(k));
					saved = [...keys, ...other];
					save(saved);
					apply(keys);
				});
			}
			this.querySelector('[data-cols-reset]')?.addEventListener('click', () => {
				saved = null;
				try {
					localStorage.removeItem(COLUMNS_KEY);
				} catch {
					/* nothing stored */
				}
				apply(standard);
			});
			document.addEventListener('click', (e) => {
				if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
			});
			menu.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && menu.open) {
					menu.open = false;
					menu.querySelector('summary')?.focus();
				}
			});
		}

		matches(row: HTMLElement, s: State) {
			return matches(s, row.dataset);
		}

		render(state: State, ui: any) {
			const { rowsBox, rows, segButtons, sortButtons, tiles, countEl, empty, defaultGroup, total } = ui;
			const group = state.group[0] && segButtons.some((b: HTMLButtonElement) => b.dataset.group === state.group[0]) ? state.group[0] : defaultGroup;
			for (const b of segButtons) b.setAttribute('aria-pressed', String(b.dataset.group === group));
			for (const tile of tiles) {
				const on = tile.dataset.tilePillar ? state.pillar.includes(tile.dataset.tilePillar) : state.feature.includes(tile.dataset.tileValue!);
				tile.setAttribute('aria-pressed', String(on));
			}

			const shown: HTMLElement[] = rows.filter((r: HTMLElement) => this.matches(r, state));
			const sort = state.sort[0] ?? '';
			const column = SORTS[sort.replace(/^-/, '')];
			for (const b of sortButtons as HTMLButtonElement[]) {
				const dir = sort === b.dataset.sort ? 'asc' : sort === `-${b.dataset.sort}` ? 'desc' : '';
				b.setAttribute('aria-pressed', String(Boolean(dir)));
				b.querySelector('.mt-cl__sorti')!.textContent = dir === 'asc' ? '▲' : dir === 'desc' ? '▼' : '↕';
			}
			if (column) {
				const dir = sort.startsWith('-') ? -1 : 1;
				shown.sort((a, b) => {
					const x = column.value(a);
					const y = column.value(b);
					return !x || !y ? Number(!x) - Number(!y) : dir * column.compare(x, y);
				});
			}
			countEl.textContent = shown.length === total ? `${total.toLocaleString('en-US')} checks` : `${shown.length.toLocaleString('en-US')} of ${total.toLocaleString('en-US')} checks`;
			empty.hidden = shown.length > 0;

			// Groups, largest first (severity in its own order), community pack checks not counted. A check in two pillars is grouped under its first.
			const buckets = new Map<string, { label: string; icon: string; tile: string; rows: HTMLElement[] }>();
			for (const row of shown) {
				const raw = group === 'none' ? '|' : group === 'severity' ? `${row.dataset.gSeverity}|${row.dataset.gSeverity}` : (row.dataset[`g${group[0].toUpperCase()}${group.slice(1)}`] ?? '|').split(';')[0];
				const [key, label = '', icon = '', tile = ''] = raw.split('|');
				if (!buckets.has(key)) buckets.set(key, { label, icon, tile, rows: [] });
				buckets.get(key)!.rows.push(row);
			}
			// Ranked by Maester's own checks, so groups of community pack checks come last.
			const own = (rows: HTMLElement[]) => rows.filter((r) => !r.hasAttribute('data-community')).length;
			const ordered = [...buckets.entries()].sort((a, b) =>
				group === 'severity'
					? SEVERITIES.indexOf(a[0]) - SEVERITIES.indexOf(b[0])
					: own(b[1].rows) - own(a[1].rows) || b[1].rows.length - a[1].rows.length || a[1].label.localeCompare(b[1].label),
			);

			rowsBox.querySelectorAll('.mt-cl__ghead, .mt-cl__more').forEach((el: Element) => el.remove());
			const fragment = document.createDocumentFragment();
			for (const [key, bucket] of ordered) {
				const id = `${group}:${key}`;
				const limit = group === 'none' ? FLAT_ROWS : GROUP_ROWS;
				const open = this.expanded.has(id) || bucket.rows.length <= limit + 2;
				if (group !== 'none') fragment.append(this.header(group, key, bucket));
				bucket.rows.forEach((row, i) => {
					row.hidden = !open && i >= limit;
					fragment.append(row);
				});
				if (!open) {
					const more = document.createElement('button');
					more.type = 'button';
					more.className = 'mt-cl__more';
					more.textContent = `Show all ${bucket.rows.length}${group === 'none' ? ' checks' : ''}`;
					more.addEventListener('click', () => {
						this.expanded.add(id);
						this.render(readState(), ui);
					});
					fragment.append(more);
				}
			}
			// The rows that do not match stay in the page, hidden, after the groups.
			const matched = new Set(shown);
			for (const row of rows) {
				if (matched.has(row)) continue;
				row.hidden = true;
				fragment.append(row);
			}
			rowsBox.append(fragment);
			this.command(state, shown, ui);
			this.chips(state, ui);
		}

		header(group: string, key: string, bucket: { label: string; icon: string; tile: string; rows: HTMLElement[] }) {
			const head = document.createElement('div');
			head.className = 'mt-cl__ghead';
			if (bucket.icon) {
				const img = document.createElement('img');
				img.src = bucket.icon;
				img.alt = '';
				img.width = img.height = 20;
				head.append(img);
			} else if (bucket.tile) {
				const tile = document.createElement('span');
				tile.className = 'mt-cl__ptile';
				tile.textContent = bucket.tile;
				head.append(tile);
			} else if (group === 'severity') {
				const sev = document.createElement('span');
				sev.className = `mt-cl__sev mt-sev--${key.toLowerCase()}`;
				sev.textContent = key;
				head.append(sev);
			}
			if (group !== 'severity') {
				const name = document.createElement('b');
				name.textContent = bucket.label;
				head.append(name);
			}
			const n = document.createElement('span');
			n.className = 'mt-cl__gn';
			n.textContent = String(bucket.rows.length);
			head.append(n);
			const bar = document.createElement('span');
			bar.className = 'mt-cl__bar mt-cl__bar--thin mt-cl__gbar';
			for (const s of SEVERITIES) {
				const c = bucket.rows.filter((r) => r.dataset.severity === s).length;
				if (!c) continue;
				const i = document.createElement('i');
				i.className = `mt-sev-bg--${s.toLowerCase()}`;
				i.style.width = `${(c / bucket.rows.length) * 100}%`;
				bar.append(i);
			}
			head.append(bar);
			if (group === 'product' && key && this.dataset.scope !== 'product') {
				const link = document.createElement('a');
				link.href = `/docs/tests/products/${key}`;
				link.textContent = `Open ${bucket.label} →`;
				head.append(link);
			}
			return head;
		}

		// The Invoke-Maester parameters for the selection. Effort, impact, technique and text are not parameters:
		// a short list is run by ID; a long one runs what the other filters select, and the note says so.
		command(s: State, shown: HTMLElement[], ui: any) {
			const { cmd, note } = ui;
			const copy = this.querySelector<HTMLButtonElement>('[data-copy]');
			const scope = this.dataset.scope;
			const parts = [this.dataset.base!];
			const builtIn = shown.filter((r) => r.dataset.source === 'maester');
			// Community pack checks are listed but left out of the command: each pack is installed and run on its own.
			const community = [...new Set(shown.filter((r) => r.hasAttribute('data-community')).map((r) => r.dataset.source!))];
			const packs = [...new Set(shown.map((r) => r.dataset.source!).filter((v) => v !== 'maester' && !community.includes(v)))];
			const products = [...new Set([...s.product, ...s.feature.map((f) => f.split('/')[0])])].filter((p) => !(scope === 'product' && p === this.dataset.value));
			const loose = s.cost.length + s.impact.length + s.mitre.length + s.author.length + s.q.length > 0;
			const notes: string[] = [];
			const show = (text: string, runnable: boolean) => {
				cmd.textContent = text;
				if (copy) copy.disabled = !runnable;
				note.textContent = notes.join(' ');
				note.hidden = notes.length === 0;
			};
			// Nothing to run: no command to copy, rather than one that runs checks the page shows as none.
			if (!shown.length) return show('No checks match these filters.', false);
			// Only community pack checks: the pack runs once it is installed, from its page on packs.maester.cloud.
			if (!builtIn.length && !packs.length) {
				notes.push(`Install the pack first: its page on packs.maester.cloud has the Install-MtPack command.`);
				return show(`Invoke-Maester -Pack ${community.join(',')} -SkipBuiltIn`, true);
			}
			// A pack runs as one assessment, whatever the filters; selectors would only deselect its family test.
			if (scope === 'pack' || !builtIn.length) {
				notes.push('The pack runs the whole assessment, with its module installed; filters choose what you read, not what runs.');
				if (community.length) notes.push(`The ${community.join(', ')} community pack checks run on their own, once the pack is installed.`);
				return show(scope === 'pack' ? parts[0] : `Invoke-Maester -Pack ${packs.join(',')} -SkipBuiltIn`, true);
			}
			if (loose && builtIn.length <= 25) {
				parts.splice(0, parts.length, `Invoke-Maester -TestId ${builtIn.map((r) => r.dataset.testId).join(',')}`);
			} else {
				if (s.suite.length) parts.push(`-Suite ${s.suite.map((v) => v.toLowerCase()).join(',')}`);
				if (products.length) parts.push(`-Product ${products.join(',')}`);
				if (s.feature.length) parts.push(`-Feature ${[...new Set(s.feature.map((f) => f.split('/')[1]))].join(',')}`);
				if (s.area.length) parts.push(`-Area ${s.area.join(',')}`);
				if (s.severity.length) parts.push(`-Severity ${s.severity.join(',')}`);
				if (loose) notes.push('Effort, impact, technique, author and search are not Invoke-Maester parameters: this runs every check the other filters select.');
			}
			// Preview checks run only when asked for.
			if (builtIn.some((r) => (r.dataset.channel ?? '').split(' ').includes('preview'))) parts.push('-IncludePreview');
			if (packs.length) notes.push(`This runs the built-in checks shown. The ${packs.join(', ')} pack checks run as their own assessment: Invoke-Maester -Pack ${packs.join(',')} -SkipBuiltIn.`);
			show(parts.join(' '), true);
		}

		// The filters that are not in the nav (from a link, a tile or the matrix), as chips that remove them.
		chips(s: State, ui: any) {
			const box = ui.chips as HTMLElement;
			box.replaceChildren();
			const add = (label: string, change: Partial<State>) => {
				const chip = document.createElement('button');
				chip.type = 'button';
				chip.className = 'mt-cl__chip';
				chip.textContent = `${label} ×`;
				chip.setAttribute('aria-label', `Remove ${label}`);
				chip.addEventListener('click', () => update(change));
				box.append(chip);
			};
			const label = (attr: string, key: string) => {
				const row = ui.rows.find((r: HTMLElement) => (r.dataset[attr] ?? '').split(';').some((v) => v.startsWith(`${key}|`)));
				return row ? (row.dataset[attr] ?? '').split(';').find((v: string) => v.startsWith(`${key}|`))!.split('|')[1] : key;
			};
			for (const p of s.product) add(label('gProduct', p), { product: s.product.filter((v) => v !== p) });
			for (const f of s.feature) add(label('gFeature', f), { feature: s.feature.filter((v) => v !== f) });
			for (const v of s.suite) add(`Suite: ${v}`, { suite: s.suite.filter((x) => x !== v) });
			for (const m of s.mitre) add(`ATT&CK ${m}`, { mitre: s.mitre.filter((x) => x !== m) });
			if (s.q[0]) add(`“${s.q[0]}”`, { q: [] });
		}
	}
	customElements.define('mt-catalog-list', CatalogList);
</script>

