---
// A post on the blog's lists: its card picture, kind, date, title, summary and authors. The whole card is the
// link (the title's link stretches over it), so it reads as one target for a pointer and one link for a screen reader.
import { Image } from 'astro:assets';
import { authorsOf, formatDate, label, readingTime, type Post } from '../../lib/blog';

interface Props {
	post: Post;
	/** The newest post: wider, with the picture beside the text. */
	featured?: boolean;
	/** Load the picture straight away (the cards in the first screen). */
	eager?: boolean;
}
const { post, featured = false, eager = false } = Astro.props;
const by = authorsOf(post);
const Heading = featured ? 'h2' : 'h3';
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
	<div class="post-card__media">
		{
			post.data.image ? (
				<Image
					src={post.data.image}
					alt=""
					widths={featured ? [640, 960, 1200] : [480, 720, 960]}
					sizes={featured ? '(min-width: 60rem) 36rem, 100vw' : '(min-width: 60rem) 24rem, (min-width: 40rem) 50vw, 100vw'}
					loading={eager ? 'eager' : 'lazy'}
					fetchpriority={featured ? 'high' : undefined}
				/>
			) : (
				<div class="post-card__placeholder" aria-hidden="true">
					<img src="/img/logo.svg" alt="" width="56" height="56" />
				</div>
			)
		}
	</div>
	<div class="post-card__body">
		<p class="post-card__meta">
			<span class="post-card__kind">{label(post)}</span>
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
		</p>
		<Heading class="post-card__title">
			<a href={`/blog/${post.id}`}>{post.data.title}</a>
		</Heading>
		<p class="post-card__summary">{post.data.description}</p>
		<p class="post-card__foot">
			<span class="post-card__faces" aria-hidden="true">
				{by.map((a) => a.picture && <img src={a.picture} alt="" width="28" height="28" loading="lazy" />)}
			</span>
			<span class="post-card__names">{by.map((a) => a.name).join(', ')}</span>
			<span class="post-card__time">{readingTime(post)} min read</span>
		</p>
	</div>
</article>

<style>
	.post-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 18px;
		background: var(--mt-surface, var(--sl-color-black));
		transition:
			border-color 0.2s ease,
			transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.2s ease;
	}
	.post-card:hover {
		border-color: var(--sl-color-gray-4);
		transform: translateY(-3px);
		box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.55);
	}
	.post-card:has(a:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 3px;
	}
	.post-card__media {
		aspect-ratio: 1200 / 630;
		overflow: hidden;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.post-card__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.post-card:hover .post-card__media img {
		transform: scale(1.03);
	}
	.post-card__placeholder {
		display: grid;
		place-items: center;
		height: 100%;
		background: radial-gradient(80% 90% at 80% 0%, var(--sl-color-accent-low), transparent);
	}
	.post-card__placeholder img {
		width: 56px;
		height: 56px;
	}
	.post-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.35rem 1.5rem 1.4rem;
	}
	.post-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
	}
	.post-card__kind {
		border-radius: 999px;
		padding: 0.12rem 0.6rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 600;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
	}
	.post-card__title {
		margin: 0;
		font-size: 1.3rem;
		line-height: 1.3;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}
	.post-card__title a {
		color: inherit;
		text-decoration: none;
	}
	.post-card__title a:focus-visible {
		outline: none;
	}
	/* The title's link covers the card. */
	.post-card__title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.post-card__summary {
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: 0.95rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-card__foot {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: auto 0 0;
		padding-top: 0.6rem;
		font-size: 0.82rem;
		color: var(--sl-color-gray-3);
	}
	.post-card__faces {
		display: flex;
		flex: none;
	}
	.post-card__faces img {
		width: 28px;
		height: 28px;
		border-radius: 999px;
		border: 2px solid var(--mt-surface, var(--sl-color-black));
		background: var(--sl-color-gray-6);
	}
	.post-card__faces img + img {
		margin-inline-start: -8px;
	}
	.post-card__names {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--sl-color-gray-2);
	}
	.post-card__time {
		margin-inline-start: auto;
		white-space: nowrap;
	}

	/* The newest post: picture and text side by side on wide screens. */
	@media (min-width: 60rem) {
		.post-card--featured {
			display: grid;
			grid-template-columns: 1.15fr 1fr;
		}
		.post-card--featured .post-card__media {
			aspect-ratio: auto;
			min-height: 21rem;
			border-bottom: 0;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}
		.post-card--featured .post-card__body {
			justify-content: center;
			gap: 0.9rem;
			padding: 2.5rem 2.75rem;
		}
		.post-card--featured .post-card__title {
			font-size: 2rem;
			line-height: 1.2;
			letter-spacing: -0.02em;
		}
		.post-card--featured .post-card__summary {
			font-size: 1.05rem;
			-webkit-line-clamp: 4;
		}
		.post-card--featured .post-card__foot {
			margin-top: 0.5rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.post-card,
		.post-card__media img {
			transition: none;
		}
		.post-card:hover {
			transform: none;
		}
		.post-card:hover .post-card__media img {
			transform: none;
		}
	}
</style>
