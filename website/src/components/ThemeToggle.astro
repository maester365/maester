---
// One button for the theme. It shows the current setting and moves to the next on each click: System (follow the
// device), Light, Dark. The choice is kept in localStorage under Starlight's key, so the docs and the other pages
// agree; System is stored as an empty value, as Starlight does. Icons: a half-filled circle for System (light and dark), and Nucleo's sun and moon.
---

<mt-theme-toggle>
	<button type="button" class="mt-theme" aria-label="Theme: system. Switch to light" title="Theme: system">
		<svg class="mt-theme__icon mt-theme__icon--system" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="8.5"></circle>
			<path d="M12 3.5a8.5 8.5 0 0 1 0 17z" class="fill"></path>
		</svg>
		<svg class="mt-theme__icon mt-theme__icon--light" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="5"></circle>
			<path d="M12 1v2M19.778 4.222l-1.414 1.414M23 12h-2M19.778 19.778l-1.414-1.414M12 23v-2M4.222 19.778l1.414-1.414M1 12h2M4.222 4.222l1.414 1.414"></path>
		</svg>
		<svg class="mt-theme__icon mt-theme__icon--dark" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M4 11.9309C4 16.9396 8.0596 21 13.0674 21C16.4803 21 19.4528 19.1141 21 16.3273C20.4852 16.4181 19.9554 16.4655 19.4145 16.4655C14.4068 16.4655 10.3472 12.4051 10.3472 7.39637C10.3472 5.80122 10.7589 4.30225 11.4819 3C7.23006 3.74996 4 7.46316 4 11.9309Z"></path>
		</svg>
	</button>
</mt-theme-toggle>

<script>
	type Setting = 'system' | 'light' | 'dark';
	const storageKey = 'starlight-theme';
	const order: Setting[] = ['system', 'light', 'dark'];
	const query = matchMedia('(prefers-color-scheme: light)');
	const system = () => (query.matches ? 'light' : 'dark');
	const read = (): Setting => {
		try {
			const value = localStorage.getItem(storageKey);
			return value === 'light' || value === 'dark' ? value : 'system';
		} catch {
			return 'system';
		}
	};
	const apply = (setting: Setting) => {
		document.documentElement.dataset.theme = setting === 'system' ? system() : setting;
		document.documentElement.dataset.themeSetting = setting;
		const next = order[(order.indexOf(setting) + 1) % order.length];
		for (const button of document.querySelectorAll<HTMLButtonElement>('mt-theme-toggle button')) {
			button.setAttribute('aria-label', `Theme: ${setting}. Switch to ${next}`);
			button.title = `Theme: ${setting[0].toUpperCase()}${setting.slice(1)}`;
		}
	};

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			apply(read());
			this.querySelector('button')!.addEventListener('click', () => {
				const next = order[(order.indexOf(read()) + 1) % order.length];
				try {
					localStorage.setItem(storageKey, next === 'system' ? '' : next);
				} catch {}
				apply(next);
			});
		}
	}
	query.addEventListener('change', () => {
		if (read() === 'system') apply('system');
	});
	customElements.define('mt-theme-toggle', ThemeToggle);
</script>

<style>
	.mt-theme {
		display: inline-grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 9px;
		border: 0;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
		transition: color 0.2s, background 0.2s;
	}
	.mt-theme:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.mt-theme__icon {
		grid-area: 1 / 1;
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-miterlimit: 10;
		display: none;
	}
	.mt-theme__icon .fill {
		fill: currentColor;
		stroke: none;
	}
	/* Show the current setting; before the script runs, System. */
	.mt-theme__icon--system {
		display: block;
	}
	:global(:root[data-theme-setting='light']) .mt-theme__icon--system,
	:global(:root[data-theme-setting='dark']) .mt-theme__icon--system {
		display: none;
	}
	:global(:root[data-theme-setting='light']) .mt-theme__icon--light,
	:global(:root[data-theme-setting='dark']) .mt-theme__icon--dark {
		display: block;
	}
</style>
