---
// The test catalog: every check, filtered in the browser by text, product and feature, area, suite and severity,
// with the Invoke-Maester command that runs the same selection. The full table is in the HTML, so it works without
// JavaScript and search engines see every check.
//
// Suites and severities are toggles; products (with their features, as a tree) and areas are searchable menus.
// Each filter takes several values, and the selection is kept in the URL so it can be shared.
import catalog from '../data/test-catalog.json';
import { previewLabel, releasedTests } from '../lib/versions.mjs';
import { featureIcon, productIcon, productInitials } from '../lib/report-icons.mjs';

type Taxon = { Key: string; Name: string; Product?: string };
const productNames = new Map((catalog.Taxonomy.Products as Taxon[]).map((p) => [p.Key, p.Name]));
// Feature keys repeat across products (anti-malware is in Exchange and Defender), so a feature is product/feature.
const featureNames = new Map((catalog.Taxonomy.Features as Taxon[]).map((f) => [`${f.Product}/${f.Key}`, f.Name]));
const areaNames = new Map((catalog.Taxonomy.Areas as Taxon[]).map((a) => [a.Key, a.Name]));
const severityOrder = ['Critical', 'High', 'Medium', 'Low', 'Info'];
const tests = (catalog.Tests as any[])
	.filter((t) => t.Lifecycle !== 'Deprecated')
	.map((t) => ({
		id: t.Id as string,
		title: t.Title as string,
		suite: t.Suite as string,
		product: t.Product as string,
		productName: (productNames.get(t.Product) as string) ?? t.Product,
		feature: t.Feature ? `${t.Product}/${t.Feature}` : '',
		featureName: (featureNames.get(`${t.Product}/${t.Feature}`) as string) ?? t.Feature ?? '',
		area: (t.Area as string) ?? '',
		areaName: (areaNames.get(t.Area) as string) ?? t.Area ?? '',
		severity: (t.Severity as string) || 'Info',
		previewOnly: !releasedTests.has(t.Id),
		previewCheck: t.Lifecycle === 'Preview',
	}))
	// Most severe first, so the catalog opens on the checks that matter most.
	.sort((a, b) => severityOrder.indexOf(a.severity) - severityOrder.indexOf(b.severity) || a.id.localeCompare(b.id, undefined, { numeric: true }));

const count = (key: (t: (typeof tests)[number]) => string) => {
	const map = new Map<string, number>();
	for (const t of tests) if (key(t)) map.set(key(t), (map.get(key(t)) ?? 0) + 1);
	return [...map.entries()].sort((a, b) => b[1] - a[1]);
};
const featureCounts = new Map(count((t) => t.feature));
// Products, most checks first, each with its features: the tree in the product menu.
const products = count((t) => t.product).map(([key, n]) => ({
	key,
	name: productNames.get(key) ?? key,
	count: n,
	icon: productIcon(key),
	features: [...featureCounts.entries()]
		.filter(([f]) => f.startsWith(`${key}/`))
		.map(([f, fn]) => ({ key: f, name: featureNames.get(f) ?? f.split('/')[1], count: fn, icon: featureIcon(key, f.split('/')[1]) })),
}));
const areas = count((t) => t.area).map(([key, n]) => ({ key, name: areaNames.get(key) ?? key, count: n }));
const severities = severityOrder.map((s) => [s, tests.filter((t) => t.severity === s).length] as const).filter(([, n]) => n > 0);
const previewOnlyCount = tests.filter((t) => t.previewOnly).length;

// Each suite's mark: its product's icon for the suites about one product, a stroke icon for the benchmarks.
const stroke = {
	list: 'M9 5h11M9 12h11M9 19h11M4 5l1 1 2-2M4 12l1 1 2-2M4 19l1 1 2-2',
	shield: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z',
	shieldCheck: 'M9 12l2 2 4-4M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z',
};
const suiteInfo: Record<string, { name: string; img?: string; path?: string }> = {
	Maester: { name: 'Maester', img: '/img/logo.svg' },
	CIS: { name: 'CIS benchmarks', path: stroke.list },
	CISA: { name: 'CISA SCuBA', path: stroke.shield },
	ASD: { name: 'ASD Essential Eight and ISM', path: stroke.shieldCheck },
	EIDSCA: { name: 'Entra ID Security Config Analyzer', img: productIcon('entra') },
	ORCA: { name: 'Office 365 Recommended Configuration Analyzer', img: productIcon('exchange') },
	AD: { name: 'Active Directory', img: '/report-icons/v1/features/organization.svg' },
	XSPM: { name: 'Exposure management', img: '/report-icons/v1/features/microsoft-defender-easm.svg' },
};
const suites = count((t) => t.suite).map(([key, n]) => ({ key, count: n, ...(suiteInfo[key] ?? { name: key, path: stroke.list }) }));
const bars = { Critical: 4, High: 3, Medium: 2, Low: 1, Info: 0 } as Record<string, number>;
---

<mt-test-catalog class="mt-cat not-content">
	<div class="mt-cat__bar">
		<label class="mt-cat__search">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.5-4.5"></path></svg>
			<input type="search" placeholder={`Search ${tests.length} checks by ID, title or feature`} aria-label="Search checks" data-filter="q" />
		</label>

		<div class="mt-pick" data-pick="product">
			<button type="button" class="mt-pick__trigger" aria-haspopup="dialog" aria-expanded="false">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8"></path></svg>
				<span class="mt-pick__label" data-label data-placeholder="Product and feature">Product and feature</span>
				<span class="mt-pick__chev" aria-hidden="true"></span>
			</button>
			<div class="mt-pick__panel" role="dialog" aria-label="Filter by product and feature" hidden>
				<label class="mt-pick__find">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.5-4.5"></path></svg>
					<input type="search" placeholder="Search products and features" aria-label="Search products and features" data-find />
				</label>
				<ul class="mt-pick__list">
					{
						products.map((p) => (
							<li class="mt-pick__group" data-text={p.name.toLowerCase()}>
								<div class="mt-pick__row">
									<button type="button" class="mt-pick__twisty" aria-expanded="false" aria-label={`Features of ${p.name}`} disabled={p.features.length === 0}>
										<span aria-hidden="true"></span>
									</button>
									<label class="mt-pick__item">
										<input type="checkbox" data-product={p.key} data-name={p.name} />
										{p.icon ? <img src={p.icon} alt="" width="16" height="16" loading="lazy" /> : <span class="mt-pick__tile">{productInitials(p.key)}</span>}
										<span class="mt-pick__name">{p.name}</span>
										<span class="mt-pick__n">{p.count}</span>
									</label>
								</div>
								{p.features.length > 0 && (
									<ul class="mt-pick__children" hidden>
										{p.features.map((f) => (
											<li data-text={f.name.toLowerCase()}>
												<label class="mt-pick__item">
													<input type="checkbox" data-feature={f.key} data-name={`${p.name}: ${f.name}`} />
													{f.icon ? <img src={f.icon} alt="" width="16" height="16" loading="lazy" /> : <span class="mt-pick__dot" />}
													<span class="mt-pick__name">{f.name}</span>
													<span class="mt-pick__n">{f.count}</span>
												</label>
											</li>
										))}
									</ul>
								)}
							</li>
						))
					}
				</ul>
				<p class="mt-pick__none" hidden>Nothing matches.</p>
				<div class="mt-pick__foot">
					<button type="button" data-clear>Clear</button>
					<button type="button" class="mt-pick__done" data-done>Done</button>
				</div>
			</div>
		</div>

		<div class="mt-pick" data-pick="area">
			<button type="button" class="mt-pick__trigger" aria-haspopup="dialog" aria-expanded="false">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"></path></svg>
				<span class="mt-pick__label" data-label data-placeholder="Area">Area</span>
				<span class="mt-pick__chev" aria-hidden="true"></span>
			</button>
			<div class="mt-pick__panel mt-pick__panel--narrow" role="dialog" aria-label="Filter by security area" hidden>
				<label class="mt-pick__find">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.5-4.5"></path></svg>
					<input type="search" placeholder="Search areas" aria-label="Search areas" data-find />
				</label>
				<ul class="mt-pick__list">
					{
						areas.map((a) => (
							<li class="mt-pick__group" data-text={a.name.toLowerCase()}>
								<label class="mt-pick__item">
									<input type="checkbox" data-area={a.key} data-name={a.name} />
									<span class="mt-pick__name">{a.name}</span>
									<span class="mt-pick__n">{a.count}</span>
								</label>
							</li>
						))
					}
				</ul>
				<p class="mt-pick__none" hidden>Nothing matches.</p>
				<div class="mt-pick__foot">
					<button type="button" data-clear>Clear</button>
					<button type="button" class="mt-pick__done" data-done>Done</button>
				</div>
			</div>
		</div>

		<button type="button" class="mt-tog mt-tog--new" aria-pressed="false" data-toggle="preview" data-value="1">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8z"></path></svg>
			New in {previewLabel}<span class="mt-tog__n">{previewOnlyCount}</span>
		</button>
		<button type="button" class="mt-cat__reset" data-reset hidden>Reset</button>
	</div>

	<div class="mt-cat__toggles">
		<div class="mt-cat__group" role="group" aria-label="Suite">
			<span class="mt-cat__glabel">Suite</span>
			{
				suites.map((s) => (
					<button type="button" class="mt-tog" aria-pressed="false" data-toggle="suite" data-value={s.key} title={s.name}>
						{s.img ? <img src={s.img} alt="" width="16" height="16" /> : <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>}
						{s.key}
						<span class="mt-tog__n">{s.count}</span>
					</button>
				))
			}
		</div>
		<div class="mt-cat__group" role="group" aria-label="Severity">
			<span class="mt-cat__glabel">Severity</span>
			{
				severities.map(([s, n]) => (
					<button type="button" class={`mt-tog mt-tog--sev mt-sevc--${s.toLowerCase()}`} aria-pressed="false" data-toggle="severity" data-value={s}>
						{s === 'Info' ? (
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v5M12 8h.01" /></svg>
						) : (
							<svg viewBox="0 0 16 16" class="mt-bars" aria-hidden="true">
								{[0, 1, 2, 3].map((b) => (
									<rect x={1 + b * 3.75} y={12 - b * 3} width="2.5" height={3 + b * 3} rx="0.8" class={b < bars[s] ? 'on' : ''} />
								))}
							</svg>
						)}
						{s}
						<span class="mt-tog__n">{n}</span>
					</button>
				))
			}
		</div>
	</div>

	<div class="mt-cat__cmd">
		<span class="mt-cat__label">Run these checks</span>
		<code data-cmd>Invoke-Maester</code>
		<button type="button" data-copy>Copy</button>
		<span class="mt-cat__count" data-count>{tests.length} checks</span>
	</div>
	<div class="mt-cat__scroll">
	<table>
		<thead>
			<tr><th>ID</th><th>Check</th><th class="mt-cat__product">Product</th><th>Severity</th></tr>
		</thead>
		<tbody>
			{
				tests.map((t) => (
					<tr
						data-q={`${t.id} ${t.title} ${t.featureName} ${t.productName} ${t.areaName}`.toLowerCase()}
						data-suite={t.suite}
						data-product={t.product}
						data-feature={t.feature}
						data-area={t.area}
						data-severity={t.severity}
						data-preview={t.previewOnly ? '1' : ''}
					>
						<td class="mt-cat__id">
							<a href={`/docs/tests/${t.id}`}>{t.id}</a>
						</td>
						<td>
							{t.title}
							{t.previewOnly && (
								<span class="mt-mark">
									<span class="mt-mark__preview">New in {previewLabel}</span>
									<span class="mt-mark__stable">Preview {previewLabel}</span>
								</span>
							)}
							{t.previewCheck && <span class="mt-cat__check">-IncludePreview</span>}
						</td>
						<td class="mt-cat__product" title={t.featureName ? `${t.productName}: ${t.featureName}` : undefined}>
							{productIcon(t.product) ? <img src={productIcon(t.product)} alt="" width="16" height="16" loading="lazy" /> : <span class="mt-pick__tile">{productInitials(t.product)}</span>}
							{t.productName}
						</td>
						<td>
							<span class={`mt-cat__sev mt-cat__sev--${t.severity.toLowerCase()}`}>{t.severity}</span>
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
	</div>
	<p class="mt-cat__empty" data-empty hidden>No checks match. <button type="button" data-reset>Reset the filters</button></p>
	<button type="button" class="mt-cat__more" data-more hidden></button>
</mt-test-catalog>

<script>
	const names = ['q', 'suite', 'severity', 'product', 'feature', 'area', 'preview'] as const;
	type Name = (typeof names)[number];

	class TestCatalog extends HTMLElement {
		connectedCallback() {
			const search = this.querySelector<HTMLInputElement>('[data-filter="q"]')!;
			const toggles = [...this.querySelectorAll<HTMLButtonElement>('[data-toggle]')];
			const pickers = [...this.querySelectorAll<HTMLElement>('[data-pick]')];
			const productBoxes = [...this.querySelectorAll<HTMLInputElement>('input[data-product]')];
			const featureBoxes = [...this.querySelectorAll<HTMLInputElement>('input[data-feature]')];
			const areaBoxes = [...this.querySelectorAll<HTMLInputElement>('input[data-area]')];
			const rows = [...this.querySelectorAll<HTMLTableRowElement>('tbody tr')];
			const cmd = this.querySelector('[data-cmd]')!;
			const countEl = this.querySelector('[data-count]')!;
			const more = this.querySelector<HTMLButtonElement>('[data-more]')!;
			const empty = this.querySelector<HTMLElement>('[data-empty]')!;
			const resets = [...this.querySelectorAll<HTMLButtonElement>('[data-reset]')];
			const pageSize = 100;
			let showAll = false;

			const featuresOf = (product: string) => featureBoxes.filter((b) => b.dataset.feature!.startsWith(`${product}/`));
			const pressed = (name: string) => toggles.filter((t) => t.dataset.toggle === name && t.getAttribute('aria-pressed') === 'true').map((t) => t.dataset.value!);
			// A product whose box is ticked counts whole; otherwise each ticked feature counts on its own.
			const selection = (): Record<Name, string[]> => {
				const fullProducts = productBoxes.filter((b) => b.checked).map((b) => b.dataset.product!);
				return {
					q: search.value.trim() ? [search.value.trim()] : [],
					suite: pressed('suite'),
					severity: pressed('severity'),
					preview: pressed('preview'),
					product: fullProducts,
					feature: featureBoxes.filter((b) => b.checked && !fullProducts.includes(b.dataset.feature!.split('/')[0])).map((b) => b.dataset.feature!),
					area: areaBoxes.filter((b) => b.checked).map((b) => b.dataset.area!),
				};
			};

			// The product's box follows its features: ticked when all are, a dash when some are.
			const syncProduct = (product: string) => {
				const box = productBoxes.find((b) => b.dataset.product === product)!;
				const features = featuresOf(product);
				if (features.length === 0) return;
				const ticked = features.filter((f) => f.checked).length;
				box.checked = ticked === features.length;
				box.indeterminate = ticked > 0 && ticked < features.length;
			};

			const labelFor = (picker: HTMLElement, s: Record<Name, string[]>) => {
				const label = picker.querySelector<HTMLElement>('[data-label]')!;
				const picked =
					picker.dataset.pick === 'area'
						? areaBoxes.filter((b) => b.checked)
						: [...productBoxes.filter((b) => b.checked), ...featureBoxes.filter((b) => s.feature.includes(b.dataset.feature!))];
				label.textContent = picked.length === 0 ? label.dataset.placeholder! : picked.length === 1 ? picked[0].dataset.name! : `${picked[0].dataset.name} +${picked.length - 1}`;
				picker.classList.toggle('is-set', picked.length > 0);
			};

			const apply = () => {
				const s = selection();
				const q = (s.q[0] ?? '').toLowerCase();
				const has = (list: string[], value?: string) => list.length === 0 || list.includes(value ?? '');
				const byProduct = s.product.length + s.feature.length > 0;
				let shown = 0;
				let listed = 0;
				for (const row of rows) {
					const d = row.dataset;
					const match =
						(!q || d.q!.includes(q)) &&
						has(s.suite, d.suite) &&
						has(s.severity, d.severity) &&
						has(s.area, d.area) &&
						(!byProduct || s.product.includes(d.product!) || s.feature.includes(d.feature!)) &&
						(s.preview.length === 0 || d.preview === '1');
					if (match) shown++;
					// Long lists show the first page; "Show all" lists the rest.
					const visible = match && (showAll || shown <= pageSize);
					row.hidden = !visible;
					if (visible) listed++;
				}
				more.hidden = shown <= listed;
				more.textContent = `Show all ${shown} checks`;
				empty.hidden = shown > 0;
				resets[0].hidden = !names.some((n) => s[n].length);
				countEl.textContent = `${shown} check${shown === 1 ? '' : 's'}`;
				for (const picker of pickers) labelFor(picker, s);

				// The same selection as Invoke-Maester parameters. -Feature matches by key alone, so it always comes with
				// the products it belongs to, and a whole product then lists its features too.
				const parts = ['Invoke-Maester'];
				if (s.suite.length) parts.push(`-Suite ${s.suite.join(',')}`);
				const productKeys = [...new Set([...s.product, ...s.feature.map((f) => f.split('/')[0])])];
				if (productKeys.length) parts.push(`-Product ${productKeys.join(',')}`);
				if (s.feature.length) {
					const keys = new Set([...s.product.flatMap((p) => featuresOf(p).map((f) => f.dataset.feature!)), ...s.feature].map((f) => f.split('/')[1]));
					parts.push(`-Feature ${[...keys].join(',')}`);
				}
				if (s.area.length) parts.push(`-Area ${s.area.join(',')}`);
				if (s.severity.length) parts.push(`-Severity ${s.severity.join(',')}`);
				if (q && shown > 0 && shown <= 5) parts.push(`-TestId ${rows.filter((r) => !r.hidden).map((r) => r.querySelector('a')!.textContent).join(',')}`);
				cmd.textContent = parts.join(' ');

				const params = new URLSearchParams();
				for (const n of names) if (s[n].length) params.set(n, s[n].join(','));
				history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
			};

			// The filters in the URL, from a shared link (single values from older links work the same way).
			const initial = new URLSearchParams(location.search);
			const list = (n: Name) => (initial.get(n) ?? '').split(',').filter(Boolean);
			search.value = initial.get('q') ?? '';
			for (const t of toggles) t.setAttribute('aria-pressed', String(list(t.dataset.toggle as Name).includes(t.dataset.value!)));
			for (const b of productBoxes) if (list('product').includes(b.dataset.product!)) for (const f of [b, ...featuresOf(b.dataset.product!)]) f.checked = true;
			for (const b of featureBoxes) if (list('feature').includes(b.dataset.feature!)) b.checked = true;
			for (const b of areaBoxes) b.checked = list('area').includes(b.dataset.area!);
			for (const b of productBoxes) syncProduct(b.dataset.product!);

			search.addEventListener('input', apply);
			for (const t of toggles) {
				t.addEventListener('click', () => {
					t.setAttribute('aria-pressed', String(t.getAttribute('aria-pressed') !== 'true'));
					apply();
				});
			}
			for (const b of productBoxes) {
				b.addEventListener('change', () => {
					for (const f of featuresOf(b.dataset.product!)) f.checked = b.checked;
					b.indeterminate = false;
					apply();
				});
			}
			for (const b of featureBoxes) {
				b.addEventListener('change', () => {
					syncProduct(b.dataset.feature!.split('/')[0]);
					apply();
				});
			}
			for (const b of areaBoxes) b.addEventListener('change', apply);

			for (const picker of pickers) this.wirePicker(picker, apply);

			more.addEventListener('click', () => {
				showAll = true;
				apply();
			});
			for (const reset of resets) {
				reset.addEventListener('click', () => {
					search.value = '';
					for (const t of toggles) t.setAttribute('aria-pressed', 'false');
					for (const b of [...productBoxes, ...featureBoxes, ...areaBoxes]) {
						b.checked = false;
						b.indeterminate = false;
					}
					showAll = false;
					apply();
				});
			}
			this.querySelector('[data-copy]')?.addEventListener('click', (e) => {
				navigator.clipboard.writeText(cmd.textContent ?? '');
				(e.target as HTMLButtonElement).textContent = 'Copied';
				setTimeout(() => ((e.target as HTMLButtonElement).textContent = 'Copy'), 1500);
			});
			apply();
		}

		// A menu that opens under its button: a search box, the options (a tree for products and their features), and
		// Clear and Done. It closes on Escape, Done, or a click outside it.
		wirePicker(picker: HTMLElement, apply: () => void) {
			const trigger = picker.querySelector<HTMLButtonElement>('.mt-pick__trigger')!;
			const panel = picker.querySelector<HTMLElement>('.mt-pick__panel')!;
			const find = panel.querySelector<HTMLInputElement>('[data-find]')!;
			const groups = [...panel.querySelectorAll<HTMLElement>('.mt-pick__group')];
			const none = panel.querySelector<HTMLElement>('.mt-pick__none')!;

			const expand = (group: HTMLElement, open: boolean) => {
				const twisty = group.querySelector<HTMLButtonElement>('.mt-pick__twisty');
				const children = group.querySelector<HTMLElement>('.mt-pick__children');
				if (!twisty || !children) return;
				twisty.setAttribute('aria-expanded', String(open));
				children.hidden = !open;
			};
			const close = (focus = false) => {
				if (panel.hidden) return;
				panel.hidden = true;
				trigger.setAttribute('aria-expanded', 'false');
				if (focus) trigger.focus();
			};
			const open = () => {
				for (const other of this.querySelectorAll<HTMLElement>('.mt-pick__panel')) if (other !== panel) other.hidden = true;
				panel.hidden = false;
				trigger.setAttribute('aria-expanded', 'true');
				// Keep the menu on screen: on a narrow page, slide it left as far as it needs.
				panel.style.left = '0px';
				const overflow = panel.getBoundingClientRect().right - (document.documentElement.clientWidth - 12);
				if (overflow > 0) panel.style.left = `${-overflow}px`;
				find.focus();
			};

			trigger.addEventListener('click', () => (panel.hidden ? open() : close()));
			panel.querySelector('[data-done]')!.addEventListener('click', () => close(true));
			panel.querySelector('[data-clear]')!.addEventListener('click', () => {
				for (const box of panel.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
					box.checked = false;
					box.indeterminate = false;
				}
				apply();
			});
			for (const group of groups) {
				group.querySelector('.mt-pick__twisty')?.addEventListener('click', (e) => {
					const twisty = e.currentTarget as HTMLButtonElement;
					expand(group, twisty.getAttribute('aria-expanded') !== 'true');
				});
			}
			// Search matches a product (with all its features) or a feature (opening its product to show it).
			find.addEventListener('input', () => {
				const q = find.value.trim().toLowerCase();
				let any = false;
				for (const group of groups) {
					const items = [...group.querySelectorAll<HTMLElement>('.mt-pick__children > li')];
					const self = group.dataset.text!.includes(q);
					let child = false;
					for (const item of items) {
						const hit = !q || self || item.dataset.text!.includes(q);
						item.hidden = !hit;
						child ||= !!q && item.dataset.text!.includes(q);
					}
					group.hidden = !(self || child);
					if (q) expand(group, child);
					any ||= !group.hidden;
				}
				if (!q) for (const group of groups) expand(group, false);
				none.hidden = any;
			});
			panel.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					e.preventDefault();
					close(true);
				}
				// Up and down move through the visible options.
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					const boxes = [...panel.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')].filter((b) => b.offsetParent !== null);
					const at = boxes.indexOf(document.activeElement as HTMLInputElement);
					const next = e.key === 'ArrowDown' ? Math.min(at + 1, boxes.length - 1) : at - 1;
					e.preventDefault();
					if (next < 0) find.focus();
					else boxes[next]?.focus();
				}
				if ((e.key === 'ArrowRight' || e.key === 'ArrowLeft') && document.activeElement instanceof HTMLInputElement && document.activeElement.dataset.product) {
					e.preventDefault();
					expand(document.activeElement.closest<HTMLElement>('.mt-pick__group')!, e.key === 'ArrowRight');
				}
			});
			document.addEventListener('pointerdown', (e) => {
				if (!picker.contains(e.target as Node)) close();
			});
		}
	}
	customElements.define('mt-test-catalog', TestCatalog);
</script>

