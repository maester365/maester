---
// Pricing: Maester itself is free wherever it runs; Maester Cloud is the paid option. The Cloud plans and prices live
// on maester.cloud/pricing, so this page names only the starting price and links there.
import SiteLayout from '../layouts/SiteLayout.astro';
import { community, core, format } from '../lib/check-counts';

const free = [
	{
		label: 'Your desktop',
		title: 'Run it on your own machine.',
		body: 'Install the module, connect to your tenant and get the full report in one run. Windows, macOS and Linux.',
		points: [
			`${format(core)} core checks and the full HTML report`,
			'CIS, CISA SCuBA, Zero Trust Assessment, ASD Essential Eight and more',
			`${format(community)} more checks in community packs, and checks you write yourself`,
			'Your data never leaves your machine',
			'Community support on Discord and GitHub',
			'Open source under the MIT licence',
		],
		cta: { label: 'Install Maester', href: '/docs/installation' },
	},
	{
		label: 'GitHub Actions and automation',
		shaded: true,
		title: 'Run it every day in your own pipeline.',
		body: 'GitHub Actions, Azure DevOps, Azure Automation, Azure Container Apps, GitLab or Bitbucket: Maester runs on a schedule wherever PowerShell does.',
		points: [
			'Daily runs on a schedule you set',
			'Templates, Bicep and Terraform deployments',
			'Email, Teams and Slack alerts when a check fails',
			'A report kept with every run',
			'Many tenants from one layered configuration',
			'Your schedule, your storage',
		],
		cta: { label: 'Set up automation', href: '/docs/monitoring' },
	},
];
---

<SiteLayout
	title="Pricing"
	description="Maester is free on your desktop, in GitHub Actions and in your own automation. Maester Cloud runs it securely in Azure with simplified deployment and run history, from $99 a month."
	wide
>
	<header class="head">
		<p class="eyebrow">Pricing</p>
		<h1>Spoiler: Maester is free. Wherever you run it.</h1>
		<p class="mission">
			<a href="https://maester.cloud/manifesto">Our mission</a> is to make security testing open, reusable and available to
			everyone.
		</p>
		<p class="sub">
			So every check, every pack and the full report are free and open source. Run Maester on your desktop, in GitHub Actions
			or in your own automation. When you want it run for you, there's Maester Cloud.
		</p>
	</header>

	<section class="plans" aria-label="Ways to run Maester">
		{
			free.map((p) => (
				<article class:list={['plan', { 'plan--shaded': p.shaded }]}>
					<p class="eyebrow">{p.label}</p>
					<p class="price">
						<strong>Free</strong>
						<span>forever</span>
					</p>
					<h2>{p.title}</h2>
					<p class="body">{p.body}</p>
					<ul>
						{p.points.map((point) => <li>{point}</li>)}
					</ul>
					<p class="pledge">
						Free, and staying free. Read the <a href="https://maester.cloud/manifesto">Maester Manifesto</a>.
					</p>
					<a class="site-btn plan__btn" href={p.cta.href}>
						{p.cta.label}
					</a>
				</article>
			))
		}
		<article class="plan plan--cloud">
			<p class="eyebrow">Maester Cloud</p>
			<p class="price">
				<span>From</span>
				<strong>$99</strong>
				<span>/ month</span>
			</p>
			<h2>Hosted for you, or self-hosted in your own Azure.</h2>
			<p class="body">
				Maester Cloud does the running for you, with nothing to script or schedule. Pick the hosted option and we run it for
				you, or self-host it in your own Azure subscription.
			</p>
			<ul>
				<li>Run history and drift detection for every tenant</li>
				<li>Track each finding through to resolution</li>
				<li>Alerts when something changes</li>
				<li>Your data kept isolated, in the Azure region you choose</li>
				<li>Formal support</li>
				<li>Maester MCP, and more</li>
			</ul>
			<p class="funds">
				<svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 14.25s-6-3.6-6-8.1C2 3.8 3.7 2.5 5.4 2.5c1.2 0 2.1.7 2.6 1.6.5-.9 1.4-1.6 2.6-1.6 1.7 0 3.4 1.3 3.4 3.65 0 4.5-6 8.1-6 8.1z"></path></svg>
				<span>Your subscription funds open-source Maester, free for everyone.</span>
			</p>
			<span class="cloud-cta-wrap">
				<a class="site-btn site-btn--primary cloud-cta" href="https://maester.cloud/pricing">
					<span class="cloud-cta__label">Get Maester Cloud</span>
					<span class="cloud-cta__arrow" aria-hidden="true">→</span>
				</a>
			</span>
		</article>
	</section>

	<p class="note note--small">
		Want to compare other ways to run Maester? The community has built{' '}
		<a href="/docs/community-projects#open-source">open-source</a> and{' '}
		<a href="/docs/community-projects#commercial-products-and-services">commercial</a> alternatives to Maester Cloud.
	</p>
</SiteLayout>

<script>
	// The Cloud button: a light follows the cursor across it, and a click throws embers and green ticks (checks passing) from the
	// pointer before the link opens. Nothing here runs for people who ask for reduced motion.
	const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const embers = ['#ff5f5f', '#ff8a8d', '#ffb347', '#fcd34d'];

	function burst(x: number, y: number) {
		const canvas = document.createElement('canvas');
		const ratio = Math.min(devicePixelRatio || 1, 2);
		canvas.width = innerWidth * ratio;
		canvas.height = innerHeight * ratio;
		canvas.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:9999';
		document.body.append(canvas);
		const ctx = canvas.getContext('2d')!;
		ctx.scale(ratio, ratio);
		const parts = Array.from({ length: 110 }, (_, n) => {
			// Mostly upwards, like sparks off a fire, with a few thrown wide.
			const angle = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.5;
			const speed = 5 + Math.random() * 13;
			const tick = n % 6 === 0;
			return {
				x,
				y,
				vx: Math.cos(angle) * speed,
				vy: Math.sin(angle) * speed,
				size: tick ? 16 + Math.random() * 12 : 2 + Math.random() * 4,
				color: tick ? '#4ade80' : embers[n % embers.length],
				tick,
				// A tick only tilts, so it still reads as a tick.
				spin: (Math.random() - 0.5) * 0.02,
				turn: (Math.random() - 0.5) * 0.5,
				life: 0.9 + Math.random() * 0.7,
			};
		});
		const started = performance.now();
		let last = started;
		function frame(now: number) {
			const step = Math.min((now - last) / 16.7, 3);
			last = now;
			const age = (now - started) / 1000;
			ctx.clearRect(0, 0, innerWidth, innerHeight);
			let alive = false;
			for (const p of parts) {
				const left = 1 - age / p.life;
				if (left <= 0) continue;
				alive = true;
				p.vx *= 0.985 ** step;
				p.vy = p.vy * 0.985 ** step + 0.32 * step;
				p.x += p.vx * step;
				p.y += p.vy * step;
				p.turn += p.spin * step;
				ctx.globalAlpha = Math.min(1, left * 1.6);
				ctx.fillStyle = p.color;
				ctx.shadowColor = p.color;
				ctx.shadowBlur = p.tick ? 6 : 12;
				if (p.tick) {
					ctx.save();
					ctx.translate(p.x, p.y);
					ctx.rotate(p.turn);
					ctx.font = `700 ${p.size}px system-ui, sans-serif`;
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					ctx.fillText('✓', 0, 0);
					ctx.restore();
				} else {
					ctx.beginPath();
					ctx.arc(p.x, p.y, p.size * (0.4 + left * 0.6), 0, Math.PI * 2);
					ctx.fill();
				}
			}
			if (alive) requestAnimationFrame(frame);
			else canvas.remove();
		}
		requestAnimationFrame(frame);
	}

	for (const wrap of document.querySelectorAll<HTMLElement>('.cloud-cta-wrap')) {
		const button = wrap.querySelector<HTMLAnchorElement>('.cloud-cta')!;
		const label = button.querySelector<HTMLElement>('.cloud-cta__label')!;
		const text = label.textContent;
		if (calm) continue;

		wrap.addEventListener('pointermove', (event) => {
			const box = wrap.getBoundingClientRect();
			const px = (event.clientX - box.left) / box.width;
			const py = (event.clientY - box.top) / box.height;
			button.style.setProperty('--mx', `${px * 100}%`);
			button.style.setProperty('--my', `${py * 100}%`);
		});

		button.addEventListener('click', (event) => {
			// A new tab or window (modifier keys, middle button) opens at once; the page stays to show the burst.
			const plain = event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
			const box = button.getBoundingClientRect();
			// A keyboard click has no pointer position: burst from the middle of the button.
			const x = event.clientX || box.left + box.width / 2;
			const y = event.clientY || box.top + box.height / 2;
			burst(x, y);
			button.classList.remove('is-lit');
			void button.offsetWidth;
			button.classList.add('is-lit');
			label.textContent = 'Lighting it up';
			if (!plain) return;
			event.preventDefault();
			setTimeout(() => (location.href = button.href), 900);
		});
		// Back from maester.cloud: the button as it was.
		addEventListener('pageshow', () => {
			button.classList.remove('is-lit');
			label.textContent = text;
		});
	}
</script>

<style>
	.head {
		text-align: center;
		max-width: 46rem;
		margin: clamp(1.5rem, 5vw, 3.5rem) auto clamp(2rem, 5vw, 3.5rem);
	}
	.eyebrow {
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--mt-ember-strong, #d22c31);
		margin: 0;
	}
	h1 {
		font-size: clamp(2.3rem, 5.5vw, 3.75rem);
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.07;
		text-wrap: balance;
		margin: 1rem 0 0;
	}
	.mission {
		font-size: clamp(1.2rem, 2.2vw, 1.55rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.35;
		color: var(--sl-color-white);
		margin: 1.5rem auto 0;
		text-wrap: balance;
	}
	.mission a {
		color: var(--mt-ember-strong, #d22c31);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.sub {
		font-size: clamp(1.05rem, 1.7vw, 1.25rem);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		margin: 1rem auto 0;
		text-wrap: pretty;
	}
	.plans {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.plan {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border: 1px solid var(--mt-line);
		border-radius: 20px;
		background: var(--mt-surface);
		padding: 1.5rem;
	}
	.plan h2 {
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
		margin: 0;
	}
	.price {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		margin: 0.25rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: 0.9rem;
	}
	.price strong {
		font-size: 2.25rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.body {
		color: var(--sl-color-gray-2);
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0.25rem 0 0.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: 0.9rem;
	}
	li {
		display: flex;
		gap: 0.5rem;
		line-height: 1.4;
	}
	li::before {
		content: '✓';
		color: var(--mt-pass);
		font-weight: 600;
	}
	.pledge {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.pledge a {
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.plan .site-btn {
		margin-top: auto;
		justify-content: center;
		text-align: center;
	}
	/* The automation card: a faint tint to set it apart from the desktop card. */
	.plan--shaded {
		background: color-mix(in srgb, var(--mt-surface) 97%, var(--mt-ink));
	}
	/* The free cards' button: the card's own colour with a strong outline, so it reads as a button on a white card
	   without the weight of the solid one. */
	.plan__btn {
		background: var(--mt-surface);
		border: 1.5px solid var(--sl-color-white);
		color: var(--sl-color-white);
	}
	.plan__btn:hover {
		background: var(--sl-color-white);
		color: var(--sl-color-black);
	}
	/* Maester Cloud: the dark card, whatever the page's theme. */
	.plan--cloud {
		--sl-color-white: #f5f5f7;
		--sl-color-black: #09090b;
		--sl-color-gray-2: #a1a1a6;
		--sl-color-gray-3: #86868b;
		color: #f5f5f7;
		border-color: #3d2326;
		background: radial-gradient(120% 80% at 50% 120%, #4a1418 0%, #161617 65%);
	}
	/* What a subscription pays for, set apart from the feature list. */
	.funds {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		margin: 0 0 0.5rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid rgba(255, 107, 111, 0.45);
		border-radius: 12px;
		background: rgba(255, 107, 111, 0.1);
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.4;
		color: #f5f5f7;
	}
	.funds svg {
		flex: none;
		margin-top: 0.1rem;
		color: #ff6b6f;
	}
	/* The Cloud button. At rest a slow ember ring turns around it. Under the pointer the ring speeds up and glows, a
	   light follows the cursor across it and the arrow leans in. A click squeezes it
	   and throws embers and green ticks from the pointer (the script below), then opens the link. */
	@property --cta-angle {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}
	.cloud-cta-wrap {
		position: relative;
		display: flex;
		margin-top: auto;
		border-radius: 12px;
		isolation: isolate;
	}
	.cloud-cta-wrap::before,
	.cloud-cta-wrap::after {
		content: '';
		position: absolute;
		inset: -2px;
		border-radius: inherit;
		background: conic-gradient(from var(--cta-angle), #ff5f5f, #ffb347, #fcd34d, #ff5f5f 55%, transparent 70%, transparent 85%, #ff5f5f);
		animation: cta-spin 5s linear infinite;
		z-index: -1;
	}
	.cloud-cta-wrap::after {
		inset: -6px;
		filter: blur(14px);
		opacity: 0.35;
		transition: opacity 0.3s ease;
	}
	.cloud-cta-wrap:hover::before,
	.cloud-cta-wrap:hover::after,
	.cloud-cta-wrap:focus-within::before,
	.cloud-cta-wrap:focus-within::after {
		animation-duration: 1.6s;
	}
	.cloud-cta-wrap:hover::after,
	.cloud-cta-wrap:focus-within::after {
		opacity: 0.9;
	}
	@keyframes cta-spin {
		to {
			--cta-angle: 360deg;
		}
	}
	.plan .cloud-cta {
		position: relative;
		overflow: hidden;
		flex: 1;
		gap: 0.45rem;
		margin-top: 0;
		border-color: transparent;
		border-radius: inherit;
		transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.cloud-cta:hover {
		opacity: 1;
	}
	/* A light under the cursor. */
	.cloud-cta::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(120px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 138, 80, 0.5), transparent 70%);
		opacity: 0;
		transition: opacity 0.25s ease;
		pointer-events: none;
	}
	.cloud-cta:hover::before {
		opacity: 1;
	}
	.cloud-cta__label,
	.cloud-cta__arrow {
		position: relative;
	}
	.cloud-cta__arrow {
		display: inline-block;
		transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.2, 1.4);
	}
	.cloud-cta:hover .cloud-cta__arrow,
	.cloud-cta:focus-visible .cloud-cta__arrow {
		transform: translateX(6px);
	}
	.cloud-cta:active {
		transform: scale(0.95);
		transition-duration: 0.08s;
	}
	.cloud-cta.is-lit {
		animation: cta-pop 0.6s cubic-bezier(0.2, 0.9, 0.2, 1.4);
	}
	.cloud-cta.is-lit .cloud-cta__arrow {
		transform: translateX(140px);
		opacity: 0;
		transition: transform 0.5s ease-in, opacity 0.4s ease-in;
	}
	@keyframes cta-pop {
		0% {
			transform: scale(0.92);
		}
		55% {
			transform: scale(1.06);
		}
		100% {
			transform: scale(1);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cloud-cta,
		.cloud-cta__arrow {
			transition: none;
			transform: none;
		}
		.cloud-cta-wrap::before,
		.cloud-cta-wrap::after,
		.cloud-cta.is-lit {
			animation: none;
		}
	}
	.plan--cloud .eyebrow {
		color: #ff6b6f;
	}
	.note {
		max-width: 46rem;
		margin: 2.5rem auto 1rem;
		text-align: center;
		color: var(--sl-color-gray-3);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.note--small {
		font-size: 0.82rem;
	}
	@media (max-width: 52rem) {
		.plans {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
