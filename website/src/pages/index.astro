</SiteLayout>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', () => {
			navigator.clipboard.writeText(button.dataset.copy ?? '');
			button.textContent = 'Copied';
			setTimeout(() => (button.textContent = 'Copy'), 1500);
		});
	}
	const header = document.querySelector<HTMLElement>('.site-header');
	function initShowcase() {
		// The report showcase: a tab per view of the report. It moves through the views by itself while it is on screen
		// (the line under the tab shows when the next one comes), pauses while the pointer is over it, and stops for
		// good once the reader picks a view. The pill behind the tabs and the pages slide to the new view.
		const showcase = document.querySelector<HTMLElement>('.showcase');
		if (!showcase?.querySelector('[data-view]')) return;
		const bar = showcase.querySelector<HTMLElement>('.showcase__bar')!;
		const pill = showcase.querySelector<HTMLElement>('.showcase__pill')!;
		const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[data-view]')];
		const panels = [...showcase.querySelectorAll<HTMLElement>('[data-panel]')];
		const caption = showcase.querySelector<HTMLElement>('.showcase__caption');
		const captions: Record<string, string> = JSON.parse(showcase.dataset.captions ?? '{}');
		const open = showcase.querySelector<HTMLAnchorElement>('[data-open]');
		const frame = showcase.querySelector<HTMLElement>('.showcase__frame')!;
		const demo = showcase.dataset.demo ?? '/demo/report';
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;

		const placePill = () => {
			const tab = tabs[current];
			pill.style.setProperty('--x', `${tab.offsetLeft}px`);
			pill.style.setProperty('--y', `${tab.offsetTop}px`);
			pill.style.setProperty('--w', `${tab.offsetWidth}px`);
			pill.style.setProperty('--h', `${tab.offsetHeight}px`);
		};
		// The next view's images load while this one shows, so the slide never reveals an empty page.
		const preload = (index: number) => {
			for (const img of panels[index % panels.length].querySelectorAll('img')) img.loading = 'eager';
		};

		const show = (next: number, forward = next > current) => {
			if (next === current) return;
			const from = panels[current];
			const to = panels[next];
			// The incoming page starts on the side it comes from, without animating there.
			for (const p of panels) p.classList.remove('is-moving');
			to.classList.remove('is-before', 'is-after');
			to.classList.add(forward ? 'is-after' : 'is-before');
			void to.offsetWidth;
			from.classList.add('is-moving');
			to.classList.add('is-moving');
			from.classList.replace('is-active', forward ? 'is-before' : 'is-after');
			to.classList.remove('is-before', 'is-after');
			to.classList.add('is-active');
			for (const p of panels) {
				const active = p === to;
				p.inert = !active;
				if (active) p.removeAttribute('aria-hidden');
				else p.setAttribute('aria-hidden', 'true');
			}
			tabs.forEach((t, i) => {
				t.setAttribute('aria-selected', String(i === next));
				t.tabIndex = i === next ? 0 : -1;
			});
			current = next;
			placePill();
			// On a phone the tabs scroll sideways: keep the selected one in view.
			if (bar.scrollWidth > bar.clientWidth) bar.scrollTo({ left: tabs[next].offsetLeft - 8, behavior: still ? 'auto' : 'smooth' });
			preload(next + 1);
			const view = tabs[next].dataset.view ?? '';
			if (caption) {
				caption.textContent = captions[view] ?? '';
				if (!still) caption.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 400, easing: 'ease-out' });
			}
			if (open) open.href = `${demo}#${tabs[next].dataset.hash}`;
		};

		// The reader takes over: no more moving on by itself.
		const choose = (index: number) => {
			showcase.classList.remove('is-auto');
			show(index);
		};
		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => choose(i));
			tab.addEventListener('keydown', (event) => {
				const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
				const index = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : step ? (current + step + tabs.length) % tabs.length : -1;
				if (index < 0) return;
				event.preventDefault();
				choose(index);
				tabs[index].focus();
			});
			// The progress line under the tab runs for the time each view shows; when it fills, the next view comes.
			tab.querySelector('.showcase__progress')!.addEventListener('animationend', () => {
				if (showcase.classList.contains('is-auto') && i === current) show((current + 1) % tabs.length, true);
			});
		});

		// Full screen: the frame fills the screen with the view it shows. Where a browser can't (iPhone Safari), the
		// live report opens at that view in a tab of its own instead.
		const fullscreen = showcase.querySelector<HTMLButtonElement>('[data-fullscreen]');
		fullscreen?.addEventListener('click', () => {
			if (frame.requestFullscreen && document.fullscreenEnabled) {
				showcase.classList.remove('is-auto');
				frame.requestFullscreen().catch(() => window.open(open?.href ?? demo, '_blank', 'noopener'));
			} else window.open(open?.href ?? demo, '_blank', 'noopener');
		});
		showcase.querySelector('[data-exit-fullscreen]')?.addEventListener('click', () => document.exitFullscreen?.());
		document.addEventListener('fullscreenchange', () => {
			const exit = showcase.querySelector<HTMLElement>('[data-exit-fullscreen]');
			if (exit) exit.hidden = document.fullscreenElement !== frame;
		});

		bar.classList.add('has-pill');
		placePill();
		new ResizeObserver(placePill).observe(bar);

		if (!still) {
			showcase.classList.add('is-auto', 'is-paused');
			const pause = (paused: boolean) => showcase.classList.toggle('is-paused', paused);
			let inView = false;
			let hovered = false;
			new IntersectionObserver(
				([entry]) => {
					inView = entry.isIntersecting;
					if (inView) preload(current + 1);
					pause(!inView || hovered);
				},
				{ threshold: 0.4 },
			).observe(frame);
			showcase.addEventListener('pointerenter', (event) => {
				if (event.pointerType !== 'mouse') return;
				hovered = true;
				pause(true);
			});
			showcase.addEventListener('pointerleave', () => {
				hovered = false;
				pause(!inView);
			});
		}
	}
	initShowcase();

	// Anchored tiles stop below the sticky site header.
	const setHeader = () => document.documentElement.style.setProperty('--mt-header-h', `${header?.offsetHeight ?? 60}px`);
	setHeader();
	if (header) new ResizeObserver(setHeader).observe(header);
</script>

<style>
	/* The page is a stack of chapters, each a tile of its own tone with a gap between them, so where one ends and the
	   next begins is plain: white (the page), grey and ink. Ink tiles are dark in both themes. */
