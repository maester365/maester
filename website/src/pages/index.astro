		--sl-color-white: #f5f5f7;
		--sl-color-black: #09090b;
		--sl-color-gray-2: #a1a1a6;
		--sl-color-gray-3: #86868b;
		--sl-color-gray-4: #52525b;
		--sl-color-gray-5: #3f3f46;
		--sl-color-gray-6: #27272a;
