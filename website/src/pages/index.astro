	/* What it is */
	.hero {
		min-height: 0;
		padding-bottom: 3rem;
	}
	.say {
		display: inline-block;
		vertical-align: middle;
		margin-inline: 0.15rem;
	}
	.cta-row {
		display: flex;
		justify-content: center;
		margin-top: 1.75rem;
	}
	.hero .ctas {
		margin-top: 1.25rem;
	}
	.fine {
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
		margin: 1rem 0 0;
	}

	/* The report: views to flip through, full screen if you like. */
	.showcase__bar {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex-wrap: wrap;
		border: 1px solid var(--mt-line);
		border-bottom: 0;
		border-radius: 16px 16px 0 0;
		background: var(--mt-canvas);
		padding: 0.5rem;
	}
	.showcase__bar button[role='tab'] {
		position: relative;
		z-index: 1;
		overflow: hidden;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		border: 1px solid transparent;
		border-radius: 8px;
		padding: 0.45rem 0.8rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
		transition: color 0.3s ease;
	}
	.showcase__bar button[role='tab']:hover,
	.showcase__bar button[aria-selected='true'] {
		color: var(--sl-color-white);
	}
	.showcase__bar:not(.has-pill) button[aria-selected='true'] {
		background: var(--sl-color-black);
		border-color: var(--mt-line);
	}
	.showcase__bar button:focus-visible,
	.showcase__tool:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.showcase__pill {
		position: absolute;
		top: 0;
		left: 0;
