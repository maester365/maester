---
// maester.dev home. Every count comes from the test catalog, the pack catalog, the contributor snapshot and the
// sponsor data at build time; downloads and stars are fetched live (src/lib/stats.mjs).
import SiteLayout from '../layouts/SiteLayout.astro';
import Explainer from '../components/Explainer.astro';
import InstallCommand from '../components/InstallCommand.astro';
import PronunciationButton from '../components/PronunciationButton.astro';
import CatalogGrowth from '../components/CatalogGrowth.astro';
import explorer from '../data/explorer.json';
import contributors from '../data/contributors.json';
import sponsors from '../data/sponsors.json';
import media from '../data/media.json';
import { builtIn, community, format, tests, zta } from '../lib/check-counts';
import { compact, getStats } from '../lib/stats.mjs';
import { previewLabel } from '../lib/versions.mjs';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const bySuite = (suite: string) => tests.filter((t) => t.Suite === suite).length;
const stats = await getStats();

const suites = [
	{ code: 'CIS', name: 'CIS Microsoft 365 Foundations', desc: 'The CIS benchmark for Microsoft 365, mapped requirement by requirement, with its level and profile.', count: bySuite('CIS'), href: '/docs/tests/cis' },
	{ code: 'CISA', name: 'CISA SCuBA', desc: "The US government's secure configuration baselines for Entra, Exchange, Defender, Teams and SharePoint.", count: bySuite('CISA'), href: '/docs/tests/cisa' },
	{ code: 'ZTA', name: 'Zero Trust Assessment', desc: "Microsoft's own assessment of your tenant across the Zero Trust pillars, in the same report.", count: zta, href: '/docs/packs/zero-trust-assessment', isNew: true },
	{ code: 'EIDSCA', name: 'Entra ID Security Config Analyzer', desc: 'Entra settings checked against the defaults and recommendations attackers rely on.', count: bySuite('EIDSCA'), href: '/docs/tests/eidsca' },
	{ code: 'ORCA', name: 'ORCA for Exchange Online', desc: 'Exchange Online Protection and Defender for Office 365 configuration.', count: bySuite('ORCA'), href: '/docs/tests/orca' },
	{ code: 'MT', name: 'Maester checks', desc: 'Checks written by the community for what the frameworks miss: Conditional Access, apps, Intune and more.', count: bySuite('Maester') + bySuite('XSPM'), href: '/docs/tests/maester' },
	{ code: 'AD', name: 'Active Directory', desc: 'Read-only checks for your on-premises domains: GPOs, DACLs, Kerberos, trusts and more.', count: bySuite('AD'), href: '/docs/tests/ad' },
	{ code: 'ASD', name: 'ASD Essential Eight', desc: "The Australian Signals Directorate's Essential Eight and ISM controls.", count: bySuite('ASD'), href: '/docs/tests/asd' },
	{ code: 'DISA', name: 'DISA STIGs', desc: 'The US Defense Information Systems Agency STIGs for Entra ID and Intune.', count: bySuite('DISA'), href: '/docs/tests/disa' },
	{ code: 'PACKS', name: 'Community packs', desc: 'Checks from community packs on packs.maester.cloud, among them the CIS Intune benchmarks for Windows, macOS, iOS and Edge.', count: community, href: 'https://packs.maester.cloud' },
];

const steps = [
	{ n: '1', title: 'Install', code: 'Install-Module Maester', text: 'One PowerShell module. The checks ship inside it.' },
	{ n: '2', title: 'Connect', code: 'Connect-Maester', text: 'Sign in with read-only permissions to the services you want to test.' },
	{ n: '3', title: 'Run', code: 'Invoke-Maester -Pack ZTA', text: 'Every check that applies to your tenant runs, and the report opens.' },
	{ n: '4', title: 'Automate', code: 'maester-action@main', text: 'Run it every day in GitHub Actions or Azure DevOps and get an alert when something changes.' },
];

const whatsNew = [
	{ title: 'A test engine of its own', body: 'Maester 3.0 runs its checks on its own engine: faster, with time-outs, and one row per policy or mailbox.' },
	{ title: 'Tests in the module', body: 'No separate tests folder to install or update. Update-Module updates the checks.' },
	{ title: 'Pick what to run', body: 'Select by product, feature, framework, severity or ID, and preview a run with -DryRun.' },
	{ title: 'A reason for every skip', body: "A check that doesn't run says why: missing licence, permission or connection." },
	{ title: 'Layered configuration', body: 'A base file plus per-tenant files that merge over it, for one setup across many tenants.' },
	{ title: 'Maester Packs', body: 'Install community packs, or run the Zero Trust Assessment pack that ships with Maester.' },
];

const platforms = [
	{ name: 'GitHub Actions', href: '/docs/monitoring/github' },
	{ name: 'Azure DevOps', href: '/docs/monitoring/azure-devops' },
	{ name: 'Azure Automation', href: '/docs/monitoring/azure-automation' },
	{ name: 'Azure Container Apps', href: '/docs/monitoring/azure-container-app-job' },
	{ name: 'GitLab', href: '/docs/monitoring/gitlab' },
	{ name: 'Bitbucket', href: '/docs/monitoring/bitbucket' },
	{ name: 'Terraform', href: '/docs/monitoring/azure-devops-terraform' },
	{ name: 'Email alerts', href: '/docs/alerts/email' },
	{ name: 'Teams and Slack', href: '/docs/alerts/teams' },
];

// Four community packs from packs.maester.cloud, in this order; the Zero Trust Assessment pack has a tile of its own.
// A pack the site no longer lists is left out.
const communityPacks = [...explorer.communityPacks].sort((a, b) => b.count - a.count);
const intunePacks = communityPacks.filter((p) => /\bCIS\b.*\bIntune\b/i.test(`${p.name} ${p.description}`));
const intuneChecks = intunePacks.reduce((n, p) => n + p.count, 0);
const featuredPacks = ['JL.CISW11INT.L1', 'CLT.UA', 'LPMS', 'RKS.IA'];
const packs = featuredPacks
	.map((code) => communityPacks.find((p) => p.code === code))
	.filter((p) => p !== undefined)
	.map((p) => ({ name: p.name, desc: p.description, tests: p.count, by: p.publisher, href: p.url, banner: (p as { banner?: string }).banner ?? '' }));

// The views of the real report (public/demo/report.html, sample data for Contoso), captured by
// scripts/capture-demo-report.mjs.
const reportViews = [
	{ name: 'overview', hash: '/', label: 'Overview', alt: 'The Maester report overview: 57% of checks passed, failures by severity, and the checks to fix first', caption: 'One page that says how your tenant is doing, what changed since the last run, and what to fix first.' },
	{ name: 'plan', hash: '/plan', label: 'Action plan', alt: 'The action plan: every failed check ranked by severity, user impact and effort', caption: 'Every failure ranked by severity, user impact and effort, with the quick wins marked.' },
	{ name: 'test', hash: '/CIS.M365.1.1.1', label: 'A finding', alt: 'A failed check opened in a panel: what an attacker could do, what Maester found, and how to fix it', caption: 'A finding opens beside the list: what an attacker could do, what Maester found, and how to fix it.' },
	{ name: 'framework', hash: '/framework/cis-m365', label: 'Frameworks', alt: 'Coverage of the CIS Microsoft 365 benchmark, requirement by requirement, with the frameworks menu open beside it', caption: 'Coverage of CIS, CISA SCuBA, the Essential Eight and NIST, requirement by requirement.' },
	{ name: 'attack', hash: '/attack', label: 'MITRE ATT&CK', alt: 'The MITRE ATT&CK techniques that failed checks leave open', caption: 'The attack techniques each gap leaves open, mapped to MITRE ATT&CK.' },
	{ name: 'zt-board', hash: '/pack/zta/plan/identity', label: 'Zero Trust plan', alt: "The Zero Trust plan for Identity as a board: swimlanes as rows, the workshop's First, Then and Next phases as columns, each task coloured by what the run found", caption: "Microsoft's Zero Trust workshop as a plan: each task in its swimlane and phase, coloured by what this run found." },
	{ name: 'zt-table', hash: '/pack/zta/plan/identity#table', label: 'Plan as a table', alt: 'The same Zero Trust plan as a table, grouped by functional area and swimlane, with status, phase, priority, checks, effort and user impact', caption: 'The same plan as a table: status, phase, priority, effort and licence for every task.' },
	{ name: 'zt-report', hash: '/reports/zero-trust-assessment', label: 'Zero Trust report', alt: "Microsoft's own Zero Trust Assessment report, with its Sankey chart of results by pillar, opened inside the Maester report", caption: "Microsoft's own Zero Trust Assessment report, Sankey chart and all, one click away in the same file." },
	{ name: 'zta', hash: '/pack/zta', label: 'Zero Trust results', alt: "Microsoft's Zero Trust Assessment results by pillar, inside the Maester report", caption: "Microsoft's Zero Trust Assessment results by pillar, beside Maester's own checks." },
// A view shows once scripts/capture-demo-report.mjs has captured it (the build runs from website/).
].filter((v) => existsSync(join(process.cwd(), 'public', 'demo', 'views', `${v.name}-light.webp`)));

const story = media.stories.find((s) => s.approved);
// The demo report: the host serves public/demo/report.html at /demo/report; the dev server only by its file name.
// Maester and Maester Cloud side by side, for the comparison near the end of the page.
const compare = [
	{ what: 'Checks, packs and report', core: 'Every one', cloud: 'The checks in Maester 2.3 for now, plus your Zero Trust Assessment results. Packs and checks new in 3.0 aren\'t in managed runs yet, and Active Directory checks run with Maester itself' },
	{ what: 'Where it runs', core: 'Your desktop, GitHub Actions or your own pipelines', cloud: 'Securely in your own Azure subscription' },
	{ what: 'Your data', core: 'Stays on your machine or in your own pipeline', cloud: 'Report data never leaves the Azure region you choose' },
	{ what: 'Setup', core: 'You install, schedule and store the reports', cloud: 'Simplified deployment, nothing to script' },
	{ what: 'Run history', core: 'One report per run', cloud: 'Every run, for every tenant' },
	{ what: 'Fixing findings', core: 'Compare one report with the next yourself', cloud: 'Track each finding through to resolution' },
	{ what: 'Drift', core: 'Drift checks against a baseline you keep', cloud: 'Changes between runs, detected for you' },
	{ what: 'Tenants', core: 'One tenant per run', cloud: 'Every tenant in one place' },
	{ what: 'Alerts', core: 'Email and Teams alerts you set up', cloud: 'Built in' },
	{ what: 'Support', core: 'The community on Discord and GitHub', cloud: 'Formal support' },
	{ what: 'Price', core: 'Free', cloud: 'From $99 a month, plus the Azure resources it uses' },
	{ what: 'Supports Maester', core: 'Contribute checks or sponsor the maintainers', cloud: 'Your subscription keeps Maester and its checks free for everyone' },
];
const demoUrl = import.meta.env.DEV ? '/demo/report.html' : '/demo/report';
const avatars = contributors.profiles.filter((p: any) => p.avatar).slice(0, 18);
const featured = (sponsors as any).featured ?? [];
const backers = (sponsors as any).backers ?? [];
// The maintainers and test writers who take GitHub sponsorships.
const people = [...((sponsors as any).maintainers ?? []), ...((sponsors as any).testAuthors ?? [])].filter((p: any) => p.sponsorUrl && p.avatar);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Maester',
	applicationCategory: 'SecurityApplication',
	operatingSystem: 'Windows, macOS, Linux',
	description: 'Open-source PowerShell framework that tests the security configuration of Microsoft 365, Entra ID, Azure and Active Directory.',
	url: 'https://maester.dev',
	downloadUrl: 'https://www.powershellgallery.com/packages/Maester',
	license: 'https://opensource.org/licenses/MIT',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<SiteLayout
	title="Maester: open-source security testing for Microsoft 365"
	description={`Test your Microsoft 365, Entra, Azure and Active Directory security every day, in one run. ${format(builtIn)} built-in checks across CIS, CISA SCuBA, EIDSCA and ORCA, plus Microsoft's Zero Trust Assessment. Free and open source.`}
	jsonLd={jsonLd}
>
	<div class="tiles">
		<!-- What it is: the hero, and the report it writes, as views to flip through. -->
		<section class="tile tile--white hero" id="what">
			<a href="https://github.com/maester365/maester" class="chip"><span class="dot dot--pass"></span>Open source · MIT · Free forever</a>
			<h1>Test your Microsoft 365 <span class="ember">security</span>, every day, in one run.</h1>
			<p class="sub">
				Maester<span class="say"><PronunciationButton /></span> checks Entra, Azure, Exchange, Teams and Active Directory against CIS, CISA, Microsoft's Zero Trust Assessment and more, and writes a report you can act on.
			</p>
			<div class="cta-row">
				<InstallCommand variant="hero" />
			</div>
			<div class="ctas">
				<a class="pill-btn" href="/docs/installation">Quickstart</a>
				<a class="more" href={demoUrl} target="_blank" rel="noopener">Try the live demo</a>
			</div>
			<p class="fine">Runs on Windows, macOS and Linux · Nothing leaves your tenant</p>

			{reportViews.length > 0 && (
				<div class="stage showcase" aria-label="The Maester report" data-demo={demoUrl} data-captions={JSON.stringify(Object.fromEntries(reportViews.map((v) => [v.name, v.caption])))}>
					<div class="showcase__bar" role="tablist" aria-label="Views of the report">
						<span class="showcase__pill" aria-hidden="true"></span>
						{
							reportViews.map((v, i) => (
								<button type="button" role="tab" id={`view-${v.name}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : -1} aria-controls="showcase-frame" data-view={v.name} data-hash={v.hash}>
									{v.label}
									<span class="showcase__progress" aria-hidden="true"></span>
								</button>
							))
						}
						<span class="showcase__tools">
							<button type="button" class="showcase__tool" data-fullscreen aria-label="Show the report full screen" title="Full screen">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
							</button>
							<a class="showcase__tool" href={demoUrl} target="_blank" rel="noopener" data-open aria-label="Open the live report in a new tab" title="Open in a new tab">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
							</a>
						</span>
					</div>
					<div class="showcase__frame" id="showcase-frame" role="tabpanel" aria-label="Report view">
						{
							reportViews.map((v, i) => (
								<div data-panel={v.name} class={i === 0 ? 'is-active' : 'is-after'} aria-hidden={i === 0 ? undefined : 'true'} inert={i !== 0}>
									<img class="mt-light-only" src={`/demo/views/${v.name}-light.webp`} alt={v.alt} width="1600" height="1000" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
									<img class="mt-dark-only" src={`/demo/views/${v.name}-dark.webp`} alt={v.alt} width="1600" height="1000" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
								</div>
							))
						}
						<button type="button" class="showcase__exit" data-exit-fullscreen hidden>Exit full screen</button>
					</div>
					<p class="showcase__caption">{reportViews[0]?.caption}</p>
				</div>
			)}
		</section>

		<!-- Proof -->
		<section class="proof" aria-label="Maester in numbers">
			<div class="proof__grid">
				<div><strong>{compact(stats.downloads, true)}</strong><span>PowerShell Gallery downloads</span></div>
				<div><strong>{format(builtIn + zta + community)}</strong><span>Checks</span></div>
				<div><strong>{compact(stats.stars)}</strong><span>GitHub stars</span></div>
				<div><strong>{contributors.profiles.length}+</strong><span>Contributors</span></div>
			</div>
		</section>

		<!-- 01 The checks -->
		<section class="tile tile--ink mt-dark-tile" id="checks">
			<p class="chapter"><b>01</b>The checks</p>
			<h2>{format(builtIn + zta + community)} checks. Every framework your auditors ask about.</h2>
			<p class="sub">Each check names the requirement it implements, so one report answers CIS, CISA, Microsoft's Zero Trust Assessment, MITRE ATT&amp;CK and NIST at once.</p>
			<div class="ctas">
				<a class="pill-btn" href="/docs/tests">Browse the checks</a>
				<a class="more" href="/docs/tests/frameworks">How checks map to frameworks</a>
			</div>
			<div class="frameworks">
				{
					suites.map((s) => (
						<a class="fw" href={s.href} title={s.desc}>
							<b>{format(s.count)}</b>
							{s.name}
						</a>
					))
				}
			</div>
			<div class="stage stage--left">
				<CatalogGrowth bare />
			</div>
		</section>

		<!-- 02 How it works -->
		<section class="tile tile--grey" id="how">
			<p class="chapter"><b>02</b>How it works</p>
			<h2>From install to a report in five minutes.</h2>
			<p class="sub">Then run it every night from the pipeline you already have.</p>
			<div class="stage stage--left">
				<Explainer slug="how-it-works" heading={false} />
				<ol class="steps">
					{steps.map((s) => <li><span class="mono muted">{s.n}</span><strong>{s.title}</strong><code>{s.code}</code></li>)}
				</ol>
				<p class="runs">
					Runs in {platforms.slice(0, -2).map((p, i, list) => <>{i > 0 && (i === list.length - 1 ? ' and ' : ', ')}<a href={p.href}>{p.name}</a></>)}, and sends results to <a href="/docs/alerts/email">email</a>, <a href="/docs/alerts/teams">Teams and Slack</a>.
				</p>
			</div>
		</section>

		<!-- 03 Extend -->
		<div class="split-tiles" id="extend">
			<section class="tile tile--white tile--wide">
				<p class="chapter"><b>03</b>Maester Packs</p>
				<h2>Need a check Maester doesn't have? Add a pack.</h2>
				<p class="sub">
					Packs add checks from Microsoft and the community, in the same report.{' '}
					{intuneChecks > 0 && <>The community's CIS Intune benchmark packs add {format(intuneChecks)} device checks on their own, one for each setting.</>}
				</p>
				<div class="ctas">
					<a class="pill-btn" href="https://packs.maester.cloud">Browse packs</a>
					<a class="more" href="/docs/packs">How packs work</a>
				</div>
				<div class="stage packs">
					{
						packs.map((p) => (
							<a class="card pack" href={p.href}>
								{p.banner && <img class="pack__banner" src={p.banner} alt="" width="1200" height="630" loading="lazy" decoding="async" />}
								<span class="mono muted">Community pack · {format(p.tests)} checks</span>
								<strong>{p.name}</strong>
								<span class="muted">{p.desc}</span>
								<span class="mono muted pack__by">by {p.by}</span>
							</a>
						))
					}
				</div>
			</section>
			<section class="tile tile--grey tile--wide zta-tile">
				<p class="chapter">Zero Trust Assessment</p>
				<h2>Microsoft's assessment, in your Maester report.</h2>
				<p class="sub">The pack ships with Maester. One command runs both, and the plan turns the results into work.</p>
				<div class="ctas">
					<a class="pill-btn" href="/docs/packs/zero-trust-assessment">How the pack works</a>
					<a class="more" href={`${demoUrl}#/pack/zta/plan/identity`} target="_blank" rel="noopener">See the plan</a>
					<a class="more" href="https://microsoft.github.io/zerotrustassessment/demo" target="_blank" rel="noopener">Microsoft's demo report</a>
				</div>
				<div class="zta-stage">
					<pre class="peek zta-cmd"><span class="blue">Invoke-Maester</span> -Pack ZTA</pre>
					<a class="zta-shot" href="https://microsoft.github.io/zerotrustassessment/demo" target="_blank" rel="noopener" aria-label="Open Microsoft's Zero Trust Assessment demo report">
						<img class="mt-light-only" src="/img/zta/zta-demo-light.webp" alt="Microsoft's Zero Trust Assessment report: test results for each pillar and Sankey charts of the authentication methods privileged users and all users have registered" width="1920" height="1222" loading="lazy" decoding="async" />
						<img class="mt-dark-only" src="/img/zta/zta-demo-dark.webp" alt="Microsoft's Zero Trust Assessment report: test results for each pillar and Sankey charts of the authentication methods privileged users and all users have registered" width="1920" height="1222" loading="lazy" decoding="async" />
					</a>
				</div>
			</section>
			<section class="tile tile--white tile--wide code-tile">
				<div class="code-tile__text">
					<p class="chapter">Security config as code</p>
					<h2>Define your security config as code.</h2>
					<p class="sub">Write each policy as a Maester test: one PowerShell function that says how your tenant must be set up. Maester runs it with everything else and puts it in the same report.</p>
					<ul class="code-points">
						<li><strong>Policies in a repository.</strong> <span class="muted">Every rule your tenant must follow, versioned and reviewed like any other code.</span></li>
						<li><strong>Regression tests for your tenant.</strong> <span class="muted">Run them after every change, by hand, from a pipeline or after Terraform, and see at once what a change broke.</span></li>
						<li><strong>Guardrails for AI agents.</strong> <span class="muted">When an agent changes your configuration, it runs your Maester tests to check its own work, and keeps running them to watch for drift.</span></li>
					</ul>
					<div class="ctas">
						<a class="more" href="/docs/writing-tests/first-custom-test">Write your first test</a>
						<a class="more" href="/test-builder">Test builder</a>
					</div>
				</div>
				<pre class="peek code-tile__code"><span class="blue">function</span> Test-CT1001 &#123;
    [MaesterTest(Id = <span class="green">'CT.1001'</span>,
        Title = <span class="green">'Our licensing groups are not empty'</span>)]
    param()
    <span class="muted-code"># The groups that assign licences in this tenant</span>
    <span class="blue">foreach</span> ($name <span class="blue">in</span> <span class="green">'LIC-M365-E5'</span>, <span class="green">'LIC-Copilot'</span>, <span class="green">'LIC-Intune-Suite'</span>) &#123;
        $group = Invoke-MtGraphRequest <span class="green">'groups'</span> -Filter <span class="green">"displayName eq '$name'"</span>
        <span class="blue">if</span> (-not $group) &#123; <span class="blue">return</span> $false &#125;
        $count = Invoke-MtGraphRequest <span class="green">"groups/$($group.id)/transitiveMembers/`$count"</span>
        <span class="blue">if</span> ($count -eq 0) &#123; <span class="blue">return</span> $false &#125;
    &#125;
    $true
&#125;</pre>
			</section>
		</div>

		<!-- 04 What's new -->
		<section class="tile tile--grey tile--short" id="new">
			<p class="chapter"><b>04</b>New in {previewLabel}</p>
			<h2>Maester {previewLabel}. Rebuilt to run faster and say more.</h2>
			<p class="sub">A test engine of its own, checks that ship in the module, and a reason for every skip.</p>
			<div class="ctas">
				<a class="pill-btn" href="/blog/maester-3-0">Read the launch post</a>
				<a class="more" href="/docs/preview">Get the preview</a>
			</div>
			<div class="stage stage--left grid grid--3">
				{whatsNew.slice(0, 3).map((w) => <div class="card"><strong>{w.title}</strong><span class="muted">{w.body}</span></div>)}
			</div>
		</section>

		<!-- 05 Community -->
		<section class="tile tile--white" id="community">
			<p class="chapter"><b>05</b>Community</p>
			<h2>Built in the open by {contributors.profiles.length}+ contributors.</h2>
			<p class="sub">Security practitioners, Microsoft MVPs and Microsoft engineers write the checks.</p>
			<div class="faces">{avatars.map((p: any) => <a href={`/contributors/${p.id.toLowerCase()}`} title={p.name}><img src={p.avatar} alt={p.name} loading="lazy" width="40" height="40" /></a>)}</div>
			<div class="ctas">
				<a class="pill-btn" href="https://discord.maester.dev">Join the Discord</a>
				<a class="more" href="/contributors">Meet the contributors</a>
			</div>
			{
				story && (
					<figure class="stage story">
						<blockquote>“{story.quote}”</blockquote>
						<figcaption>
							{story.person.name}, {story.person.role} · <a class="more" href={story.video}>Watch the episode</a>
						</figcaption>
					</figure>
				)
			}
			<div class="stage stage--left community">
				<div class="card">
					<span class="eyebrow">Listen</span>
					<strong>Maester on Entra.Chat</strong>
					<div class="episodes">
						{
							media.episodes.slice(0, 3).map((e) => (
								<a class="episode" href={e.url}>
