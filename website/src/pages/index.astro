		--tile-white: #ffffff;
		--tile-grey: #f5f5f7;
		--tile-ink: #161617;
		--tile-gap: 12px;
		display: flex;
		flex-direction: column;
		gap: var(--tile-gap);
		padding-bottom: var(--tile-gap);
	}
	/* Apple's text greys: softer than Starlight's zinc, so a page of large type doesn't read as harsh. */
	:global(:root[data-theme='light']) .tiles {
		--sl-color-white: #1d1d1f;
		--sl-color-gray-2: #424245;
		--sl-color-gray-3: #6e6e73;
		color: #1d1d1f;
	}
	:global(:root[data-theme='dark']) .tiles {
		--tile-white: var(--mt-ground);
		--tile-grey: #1c1c1e;
		--tile-ink: #1f1012;
	}
	.tile {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		min-height: 40rem;
		padding: clamp(3.5rem, 8vw, 5.5rem) 1rem clamp(3rem, 7vw, 4.5rem);
		scroll-margin-top: var(--mt-header-h, 3.8rem);
