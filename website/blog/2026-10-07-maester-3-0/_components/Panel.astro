---
import styles from "../styles.module.css";
const root = (cls: string) => `${styles.root} ${cls}`;
const { title, variant } = Astro.props;
const cls = variant === "old" ? styles.panelOld : variant === "now" ? styles.panelNow : "";
---

<div class={`${styles.panel} ${cls}`}><h4>{title}</h4><slot /></div>
