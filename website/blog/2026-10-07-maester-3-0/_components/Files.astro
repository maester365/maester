---
import styles from "../styles.module.css";
const root = (cls: string) => `${styles.root} ${cls}`;
const { files } = Astro.props;
---

<div class={root(styles.files)}>{files.map(({ name, tag, text }: any) => <div class={styles.file}>{tag && <span class={styles.fileTag}>{tag}</span>}<h4>{name}</h4><p>{text}</p></div>)}</div>
