---
import styles from "../styles.module.css";
const root = (cls: string) => `${styles.root} ${cls}`;
const { items } = Astro.props;
const tone: Record<string, string> = { Passed: styles.good, Failed: styles.bad, Error: styles.bad, Skipped: styles.warn, Investigate: styles.warn };
---

<div class={root(styles.statuses)}>{items.map((s: string) => <span class={`${styles.pill} ${tone[s] ?? ""}`}>{s}</span>)}</div>
