---
import styles from "../styles.module.css";
const root = (cls: string) => `${styles.root} ${cls}`;
const { layers } = Astro.props;
---

<div class={root(styles.layers)} aria-label="Config layers, highest priority first">{layers.map(({ name, text, rank }: any) => <div class={styles.layer}><div><code>{name}</code><br /><small>{text}</small></div><small>{rank}</small></div>)}</div>
