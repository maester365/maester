---
import styles from "../styles.module.css";
const root = (cls: string) => `${styles.root} ${cls}`;
const { steps } = Astro.props;
---

<ol class={root(styles.pipeline)}>{steps.map(({ title, text, cs }: any) => <li class={cs ? styles.cs : undefined}><div class={styles.step}><h4>{title}{cs && <span class={styles.lang}>C#</span>}</h4><p>{text}</p></div></li>)}</ol>
