---
import styles from "../styles.module.css";
const root = (cls: string) => `${styles.root} ${cls}`;
const { gates } = Astro.props;
---

<div class={root(styles.gates)}>{gates.map(([name, reason]: [string, string], i: number) => <>{i > 0 && <span class={styles.arrow}>→</span>}<div class={styles.gate}><b>{name}</b><span>{reason}</span></div></>)}</div>
