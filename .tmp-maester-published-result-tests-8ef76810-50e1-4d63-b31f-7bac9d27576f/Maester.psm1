        }

        $nestedAssignments = @()
        foreach ($app in $apps) {
            $assignedGroups = Invoke-MtGraphRequest -RelativeUri "servicePrincipals/$($app.id)/appRoleAssignedTo" |
                Where-Object { $_.principalType -eq 'Group' }

            foreach ($group in $assignedGroups) {
