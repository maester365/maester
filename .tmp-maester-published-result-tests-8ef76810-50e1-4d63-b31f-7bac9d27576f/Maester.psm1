    [MaesterTest(
        Id = 'CIS.M365.3.1.1',
        Title = 'Ensure Microsoft 365 audit log search is Enabled',
        Severity = 'High',
        Category = 'CIS',
        Tag = ('CIS E3', 'CIS E3 Level 1', 'CIS M365 v7.0.0', 'L1'),
        Service = 'ExchangeOnline',
        Author = 'NZLostboy',
        Contributor = 'thomas-s-schmidt'
    )]
    [CmdletBinding()]
    [OutputType([bool])]
    param()

    Write-Verbose 'Get audit log search status'
