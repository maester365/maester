        }

        $testResult = (($enableInternalSenderAdminNotification | Measure-Object).Count -ge 1) -and (($internalSenderAdminAddress | Measure-Object).Count -ge 1)

        $portalLink = 'https://security.microsoft.com/antimalwarev2'

        if ($testResult) {
